    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { EditorMode } from \'../types/editor\';\nimport { ModeToggle } from \'./ModeToggle\';\n\ninterface ToolbarProps {\n  mode: EditorMode;\n  onToggleMode: () => void;\n  onFormat: (command: string, value?: string) => void;\n  activeFormats?: Record<string, boolean>;\n  onSidebarToggle?: () => void;\n  isSidebarOpen?: boolean;\n}\n\nexport const Toolbar: React.FC<ToolbarProps> = ({\n  mode,\n  onToggleMode,\n  onFormat,\n  activeFormats = {},\n  onSidebarToggle,\n  isSidebarOpen = true,\n}) => {\n  const tools = [\n    { id: \'bold\', label: \'Bold (Ctrl+B)\', icon: \'\342\232\224\357\270\217\', cmd: \'bold\' },\n    { id: \'italic\', label: \'Italic (Ctrl+I)\', icon: \'\360\237\223\234\', cmd: \'italic\' },\n    { id: \'underline\', label: \'Underline (Ctrl+U)\', icon: \'\342\234\222\357\270\217\', cmd: \'underline\' },\n    { id: \'h1\', label: \'Heading 1\', icon: \'\360\237\252\250\', cmd: \'formatBlock\', value: \'<h1>\' },\n    { id: \'h2\', label: \'Heading 2\', icon: \'\360\237\247\261\', cmd: \'formatBlock\', value: \'<h2>\' },\n    { id: \'h3\', label: \'Heading 3\', icon: \'\360\237\223\246\', cmd: \'formatBlock\', value: \'<h3>\' },\n    { id: \'ul\', label: \'Bullet List\', icon: \'\360\237\223\213\', cmd: \'insertUnorderedList\' },\n    { id: \'ol\', label: \'Numbered List\', icon: \'\360\237\224\242\', cmd: \'insertOrderedList\' },\n    { id: \'quote\', label: \'Quote\', icon: \'\360\237\222\254\', cmd: \'formatBlock\', value: \'blockquote\' },\n    {\n      id: \'link\',\n      label: \'Insert Link\',\n      icon: \'\360\237\222\216\',\n      cmd: \'custom\',\n      action: () => {\n        const url = prompt(\'Enter Minecraft Redstone URL:\', \'https://\');\n        if (url) onFormat(\'createLink\', url);\n      },\n    },\n    {\n      id: \'image\',\n      label: \'Insert Image\',\n      icon: \'\360\237\227\272\357\270\217\',\n      cmd: \'custom\',\n      action: () => {\n        const url = prompt(\n          \'Enter Image / Map Texture URL:\',\n          \'https://images.unsplash.com/photo-1627856013091-fed6e4e30025?w=800&auto=format&fit=crop&q=80\'\n        );\n        if (url) onFormat(\'insertImage\', url);\n      },\n    },\n  ];\n\n  return (\n    <header className=\"mc-stone-bg w-full h-16 px-3 flex items-center justify-between shadow-lg relative z-30 select-none\">\n      {/* Left: Inventory / Sidebar Toggle & Hotbar Slots */}\n      <div className=\"flex items-center gap-2 overflow-x-auto py-1 no-scrollbar\">\n        {/* Mobile / Sidebar Toggle Button */}\n        <button\n          onClick={onSidebarToggle}\n          className=\"mc-slot flex items-center justify-center text-xl shrink-0\"\n          title={isSidebarOpen ? \'Hide Inventory Sidebar\' : \'Show Inventory Sidebar\'}\n        >\n          <span>{isSidebarOpen ? \'\360\237\216\222\' : \'\360\237\223\246\'}</span>\n        </button>\n\n        <div className=\"h-8 w-0.5 bg-[#1a1a1a] border-r border-[#555] mx-1 shrink-0\" />\n\n        {/* Hotbar Item Slots */}\n        <div className=\"flex items-center gap-1.5 shrink-0\">\n          {tools.map((tool) => {\n            const isActive = activeFormats[tool.id];\n            return (\n              <button\n                key={tool.id}\n                onClick={() => {\n                  if (tool.action) {\n                    tool.action();\n                  } else {\n                    onFormat(tool.cmd, tool.value);\n                  }\n                }}\n                className={`mc-slot flex flex-col items-center justify-center group shrink-0 ${\n                  isActive ? \'active\' : \'\'\n                }`}\n                title={tool.label}\n              >\n                <span className=\"text-lg group-hover:scale-110 transition-transform\">\n                  {tool.icon}\n                </span>\n\n                {/* Minecraft style hover tooltip */}\n                <div className=\"absolute bottom-[-36px] hidden group-hover:block mc-tooltip whitespace-nowrap pointer-events-none z-50\">\n                  {tool.label}\n                </div>\n              </button>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* Right: Mode Switcher */}\n      <div className=\"flex items-center gap-3 shrink-0 pl-2\">\n        <ModeToggle mode={mode} onToggle={onToggleMode} />\n      </div>\n    </header>\n  );\n};\n"
    }
