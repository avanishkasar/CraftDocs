      replacement_content: "import React, { useState } from \'react\';\n\ninterface SpecialCharactersModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  onInsertChar: (char: string) => void;\n}\n\nexport const SpecialCharactersModal: React.FC<SpecialCharactersModalProps> = ({\n  isOpen,\n  onClose,\n  onInsertChar,\n}) => {\n  const [activeTab, setActiveTab] = useState<\'minecraft\' | \'symbols\' | \'arrows\' | \'math\'>(\'minecraft\');\n\n  if (!isOpen) return null;\n\n  const charCategories = {\n    minecraft: [\n      \'\342\232\224\357\270\217\', \'\360\237\233\241\357\270\217\', \'\360\237\222\216\', \'\342\233\217\357\270\217\', \'\360\237\217\271\', \'\360\237\223\234\', \'\360\237\247\261\', \'\360\237\247\252\', \'\360\237\224\256\', \'\360\237\214\237\', \n      \'\360\237\222\200\', \'\360\237\215\226\', \'\360\237\252\231\', \'\360\237\216\222\', \'\360\237\223\246\', \'\360\237\252\250\', \'\360\237\252\265\', \'\360\237\224\245\', \'\360\237\222\247\', \'\342\232\241\', \n      \'\360\237\237\251\', \'\360\237\237\246\', \'\360\237\237\250\', \'\360\237\237\247\', \'\360\237\237\245\', \'\360\237\237\252\', \'\342\254\233\', \'\342\254\234\', \'\360\237\247\237\', \'\360\237\225\267\357\270\217\',\n      \'\360\237\220\267\', \'\360\237\220\256\', \'\360\237\220\221\', \'\360\237\220\224\', \'\360\237\220\216\', \'\360\237\220\272\', \'\360\237\246\212\', \'\360\237\220\210\', \'\360\237\220\235\', \'\360\237\216\243\'\n    ],\n    symbols: [\n      \'\342\230\205\', \'\342\230\206\', \'\342\234\246\', \'\342\234\247\', \'\342\231\240\', \'\342\231\243\', \'\342\231\245\', \'\342\231\246\', \'\342\234\223\', \'\342\234\227\',\n      \'\302\251\', \'\302\256\', \'\342\204\242\', \'\302\247\', \'\302\266\', \'\342\200\242\', \'\342\200\243\', \'\342\201\203\', \'\342\226\252\', \'\342\226\253\',\n      \'\342\227\206\', \'\342\227\207\', \'\342\227\213\', \'\342\227\217\', \'\342\227\216\', \'\342\227\210\', \'\342\234\211\', \'\342\234\202\', \'\342\234\216\', \'\342\214\233\'\n    ],\n    arrows: [\n      \'\342\206\220\', \'\342\206\221\', \'\342\206\222\', \'\342\206\223\', \'\342\206\224\', \'\342\206\225\', \'\342\206\226\', \'\342\206\227\', \'\342\206\230\', \'\342\206\231\',\n      \'\342\207\220\', \'\342\207\221\', \'\342\207\222\', \'\342\207\223\', \'\342\207\224\', \'\342\207\225\', \'\342\236\224\', \'\342\236\234\', \'\342\236\244\', \'\342\236\245\',\n      \'\342\206\251\', \'\342\206\252\', \'\360\237\224\204\', \'\360\237\224\201\', \'\360\237\224\274\', \'\360\237\224\275\', \'\342\227\200\', \'\342\226\266\', \'\342\226\262\', \'\342\226\274\'\n    ],\n    math: [\n      \'\302\261\', \'\303\227\', \'\303\267\', \'\342\211\240\', \'\342\211\210\', \'\342\211\244\', \'\342\211\245\', \'\342\210\236\', \'\342\210\221\', \'\342\210\217\',\n      \'\342\210\232\', \'\342\210\202\', \'\342\210\253\', \'\342\210\206\', \'\317\200\', \'\302\265\', \'\302\260\', \'\342\200\260\', \'\302\274\', \'\302\275\',\n      \'\302\276\', \'\302\271\', \'\302\262\', \'\302\263\', \'\342\201\260\', \'\342\201\277\', \'\342\210\210\', \'\342\210\211\', \'\342\212\202\', \'\342\212\203\'\n    ],\n  };\n\n  return (\n    <div className=\"fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-4 backdrop-blur-xs select-none\">\n      <div className=\"mc-window max-w-lg w-full p-5 text-black relative flex flex-col gap-4\">\n        {/* Header */}\n        <div className=\"flex items-center justify-between border-b-2 border-[#555] pb-2\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"text-xl\">\342\234\250</span>\n            <h2 className=\"font-pixel text-xs uppercase tracking-wide text-gray-900 font-bold\">\n              Insert Special Characters\n            </h2>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"text-gray-600 hover:text-black font-pixel text-sm px-2 cursor-pointer\"\n          >\n            \342\234\225\n          </button>\n        </div>\n\n        {/* Category Tabs */}\n        <div className=\"flex items-center gap-1 border-b border-gray-300 pb-1\">\n          {[\n            { id: \'minecraft\', label: \'Minecraft\' },\n            { id: \'symbols\', label: \'Symbols\' },\n            { id: \'arrows\', label: \'Arrows\' },\n            { id: \'math\', label: \'Math\' },\n          ].map((tab) => (\n            <button\n              key={tab.id}\n              onClick={() => setActiveTab(tab.id as any)}\n              className={`px-3 py-1 text-xs font-pixel rounded-t transition-all ${\n                activeTab === tab.id\n                  ? \'bg-white border-t-2 border-x-2 border-blue-600 text-blue-900 font-bold -mb-1\'\n                  : \'text-gray-600 hover:text-black\'\n              }`}\n            >\n              {tab.label}\n            </button>\n          ))}\n        </div>\n\n        {/* Characters Grid */}\n        <div className=\"grid grid-cols-8 sm:grid-cols-10 gap-1.5 p-2 bg-white border border-gray-300 rounded max-h-56 overflow-y-auto\">\n          {charCategories[activeTab].map((char, index) => (\n            <button\n              key={index}\n              onClick={() => {\n                onInsertChar(char);\n                onClose();\n              }}\n              className=\"w-9 h-9 flex items-center justify-center text-lg hover:bg-blue-100 hover:border-blue-500 border border-transparent rounded transition-all cursor-pointer select-none\"\n              title={`Insert ${char}`}\n            >\n              {char}\n            </button>\n          ))}\n        </div>\n\n        {/* Footer */}\n        <div className=\"flex justify-between items-center border-t-2 border-[#555] pt-3 mt-1\">\n          <span className=\"text-[11px] text-gray-500 font-sans\">\n            Click any glyph or symbol to insert at cursor position.\n          </span>\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"mc-button px-4 py-1.5 text-xs font-pixel\"\n          >\n            Close\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
