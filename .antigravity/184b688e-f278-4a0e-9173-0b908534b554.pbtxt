      replacement_content: "import { useState, useCallback } from \'react\';\nimport { BlockType, SlashMenuItem } from \'../types/editor\';\n\nexport const SLASH_MENU_ITEMS: SlashMenuItem[] = [\n  {\n    type: \'text\',\n    label: \'Paragraph Text\',\n    shortcut: \'text\',\n    icon: \'\360\237\223\235\',\n    description: \'Plain text paragraph for standard notes.\',\n  },\n  {\n    type: \'heading1\',\n    label: \'Heading 1\',\n    shortcut: \'h1\',\n    icon: \'\360\237\252\250\',\n    description: \'Large stone heading title.\',\n  },\n  {\n    type: \'heading2\',\n    label: \'Heading 2\',\n    shortcut: \'h2\',\n    icon: \'\360\237\247\261\',\n    description: \'Medium cobblestone section title.\',\n  },\n  {\n    type: \'heading3\',\n    label: \'Heading 3\',\n    shortcut: \'h3\',\n    icon: \'\360\237\223\246\',\n    description: \'Small wood block sub-heading.\',\n  },\n  {\n    type: \'bulletList\',\n    label: \'Bullet List\',\n    shortcut: \'bullet\',\n    icon: \'\360\237\223\213\',\n    description: \'Simple bulleted inventory list.\',\n  },\n  {\n    type: \'numberedList\',\n    label: \'Numbered List\',\n    shortcut: \'number\',\n    icon: \'\360\237\224\242\',\n    description: \'Sequenced recipe order list.\',\n  },\n  {\n    type: \'quote\',\n    label: \'Callout Quote\',\n    shortcut: \'quote\',\n    icon: \'\360\237\222\254\',\n    description: \'Wisdom quote block with parchment border.\',\n  },\n  {\n    type: \'code\',\n    label: \'Redstone Code\',\n    shortcut: \'code\',\n    icon: \'\360\237\222\273\',\n    description: \'Monospaced code block with green glow.\',\n  },\n  {\n    type: \'divider\',\n    label: \'Divider Line\',\n    shortcut: \'hr\',\n    icon: \'\342\236\226\',\n    description: \'Dashed brown parchment separator line.\',\n  },\n  {\n    type: \'image\',\n    label: \'Image / Map\',\n    shortcut: \'img\',\n    icon: \'\360\237\227\272\357\270\217\',\n    description: \'Embed image URL or pixel map asset.\',\n  },\n];\n\nexport function useSlashMenu() {\n  const [isOpen, setIsOpen] = useState(false);\n  const [targetBlockId, setTargetBlockId] = useState<string | null>(null);\n  const [query, setQuery] = useState(\'\');\n  const [selectedIndex, setSelectedIndex] = useState(0);\n\n  const openMenu = useCallback((blockId: string) => {\n    setIsOpen(true);\n    setTargetBlockId(blockId);\n    setQuery(\'\');\n    setSelectedIndex(0);\n  }, []);\n\n  const closeMenu = useCallback(() => {\n    setIsOpen(false);\n    setTargetBlockId(null);\n    setQuery(\'\');\n    setSelectedIndex(0);\n  }, []);\n\n  const filteredItems = SLASH_MENU_ITEMS.filter((item) =>\n    item.label.toLowerCase().includes(query.toLowerCase()) ||\n    item.shortcut.toLowerCase().includes(query.toLowerCase()) ||\n    item.type.toLowerCase().includes(query.toLowerCase())\n  );\n\n  return {\n    isOpen,\n    targetBlockId,\n    query,\n    setQuery,\n    selectedIndex,\n    setSelectedIndex,\n    filteredItems,\n    openMenu,\n    closeMenu,\n  };\n}\n"
    }
