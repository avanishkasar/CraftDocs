  file_change {
    absolute_path_uri: "file:///src/components/Toolbar.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { EditorMode, PageSettings } from \'../types/editor\';\n\ninterface ToolbarProps {\n  mode: EditorMode;\n  onToggleMode: () => void;\n  onFormat: (command: string, value?: string) => void;\n  activeFormats?: Record<string, boolean>;\n  pageSettings?: PageSettings;\n  onOpenPageSetup?: () => void;\n  onOpenFindReplace?: () => void;\n  onOpenSpecialCharacters?: () => void;\n  onSidebarToggle?: () => void;\n  isSidebarOpen?: boolean;\n}\n\nconst MINECRAFT_COLORS = [\n  { name: \'Black\', color: \'#1a1a1a\', icon: \'\342\254\233\' },\n  { name: \'Redstone\', color: \'#dc2626\', icon: \'\360\237\224\264\' },\n  { name: \'Gold\', color: \'#d97706\', icon: \'\360\237\237\241\' },\n  { name: \'Emerald\', color: \'#16a34a\', icon: \'\360\237\237\242\' },\n  { name: \'Diamond\', color: \'#0284c7\', icon: \'\360\237\224\267\' },\n  { name: \'Lapis\', color: \'#2563eb\', icon: \'\360\237\224\265\' },\n  { name: \'Nether\', color: \'#9333ea\', icon: \'\360\237\237\243\' },\n  { name: \'Charcoal\', color: \'#4b5563\', icon: \'\342\227\275\' },\n];\n\nconst HIGHLIGHT_COLORS = [\n  { name: \'Yellow Glow\', color: \'#fef08a\', icon: \'\360\237\237\241\' },\n  { name: \'Emerald Aura\', color: \'#bbf7d0\', icon: \'\360\237\237\242\' },\n  { name: \'Diamond Shimmer\', color: \'#bae6fd\', icon: \'\360\237\224\267\' },\n  { name: \'Pink Flare\', color: \'#fbcfe8\', icon: \'\360\237\214\270\' },\n  { name: \'Orange Dusk\', color: \'#fed7aa\', icon: \'\360\237\237\240\' },\n  { name: \'None (Clear)\', color: \'transparent\', icon: \'\360\237\232\253\' },\n];\n\nexport const Toolbar: React.FC<ToolbarProps> = ({\n  mode,\n  onToggleMode,\n  onFormat,\n  activeFormats = {},\n  pageSettings,\n  onOpenPageSetup,\n  onOpenFindReplace,\n  onOpenSpecialCharacters,\n  onSidebarToggle,\n  isSidebarOpen = true,\n}) => {\n  const [showColorPicker, setShowColorPicker] = useState(false);\n  const [showHighlightPicker, setShowHighlightPicker] = useState(false);\n  const [showLineSpacing, setShowLineSpacing] = useState(false);\n  const [fontSize, setFontSize] = useState(pageSettings?.fontSize || 11);\n  const [fontFamily, setFontFamily] = useState(\'Arial, sans-serif\');\n  const [showLabels, setShowLabels] = useState(true);\n\n  const handleFontSizeChange = (delta: number) => {\n    const nextSize = Math.max(8, Math.min(72, fontSize + delta));\n    setFontSize(nextSize);\n    onFormat(\'fontSize\', nextSize.toString());\n  };\n\n  const handleFontFamilySelect = (family: string) => {\n    setFontFamily(family);\n    onFormat(\'fontName\', family);\n  };\n\n  return (\n    <header className=\"mc-stone-bg w-full min-h-[52px] px-2.5 py-1.5 flex items-center justify-between shadow-md relative z-30 select-none font-sans text-xs gap-1.5 border-b-2 border-[#1a1a1a] flex-wrap no-print\">\n      {/* Main Google Docs Action Controls Strip with visible labels */}\n      <div className=\"flex items-center gap-1.5 flex-wrap\">\n        {/* History Group */}\n        <div className=\"flex items-center gap-1 bg-[#252525]/60 p-1 border border-[#444]\">\n          <button\n            onClick={() => onFormat(\'undo\')}\n            className=\"mc-button min-w-[34px] h-10 flex flex-col items-center justify-center p-1 cursor-pointer\"\n            title=\"Undo (Ctrl+Z)\"\n          >\n            <span className=\"text-xs\">\342\206\251\357\270\217</span>\n            {showLabels && <span className=\"text-[7.5px] font-pixel text-gray-300\">UNDO</span>}\n          </button>\n          <button\n            onClick={() => onFormat(\'redo\')}\n            className=\"mc-button min-w-[34px] h-10 flex flex-col items-center justify-center p-1 cursor-pointer\"\n            title=\"Redo (Ctrl+Y)\"\n          >\n            <span className=\"text-xs\">\342\206\252\357\270\217</span>\n            {showLabels && <span className=\"text-[7.5px] font-pixel text-gray-300\">REDO</span>}\n          </button>\n          <button\n            onClick={() => window.print()}\n            className=\"mc-button min-w-[34px] h-10 flex flex-col items-center justify-center p-1 cursor-pointer\"\n            title=\"Print (Ctrl+P)\"\n          >\n            <span className=\"text-xs\">\360\237\226\250\357\270\217</span>\n            {showLabels && <span className=\"text-[7.5px] font-pixel text-gray-300\">PRINT</span>}\n          </button>\n        </div>\n\n        {/* Zoom & Page Style */}\n        <div className=\"flex items-center gap-1 bg-[#252525]/60 p-1 border border-[#444]\">\n          <div className=\"flex flex-col\">\n            {showLabels && <span className=\"text-[7.5px] font-pixel text-gray-400 px-1\">ZOOM</span>}\n            <select\n              value={pageSettings?.zoomLevel || 100}\n              onChange={(e) => onFormat(\'zoom\', e.target.value)}\n              className=\"bg-[#2d2d2d] border border-[#555] text-gray-200 text-xs px-1.5 py-0.5 rounded-none focus:outline-hidden focus:border-[#FFD700] h-6 cursor-pointer\"\n              title=\"Zoom Level\"\n            >\n              <option value=\"75\">75%</option>\n              <option value=\"90\">90%</option>\n              <option value=\"100\">100%</option>\n              <option value=\"125\">125%</option>\n              <option value=\"150\">150%</option>\n            </select>\n          </div>\n\n          <div className=\"flex flex-col\">\n            {showLabels && <span className=\"text-[7.5px] font-pixel text-gray-400 px-1\">STYLE</span>}\n            <select\n              onChange={(e) => onFormat(\'formatBlock\', e.target.value)}\n              className=\"bg-[#2d2d2d] border border-[#555] text-gray-200 text-xs px-1.5 py-0.5 rounded-none focus:outline-hidden focus:border-[#FFD700] h-6 max-w-[105px] cursor-pointer\"\n              title=\"Paragraph Style\"\n              defaultValue=\"<p>\"\n            >\n              <option value=\"<p>\">Normal text</option>\n              <option value=\"<h1>\">Heading 1</option>\n              <option value=\"<h2>\">Heading 2</option>\n              <option value=\"<h3>\">Heading 3</option>\n              <option value=\"<blockquote>\">Quote</option>\n              <option value=\"<pre>\">Code Block</option>\n            </select>\n          </div>\n\n          {/* Font Family */}\n          <div className=\"flex flex-col\">\n            {showLabels && <span className=\"text-[7.5px] font-pixel text-gray-400 px-1\">FONT</span>}\n            <select\n              value={fontFamily}\n              onChange={(e) => handleFontFamilySelect(e.target.value)}\n              className=\"bg-[#2d2d2d] border border-[#555] text-gray-200 text-xs px-1.5 py-0.5 rounded-none focus:outline-hidden focus:border-[#FFD700] h-6 max-w-[100px] cursor-pointer\"\n              title=\"Font Family\"\n            >\n              <option value=\"Arial, sans-serif\">Arial</option>\n              <option value=\"Georgia, serif\">Georgia</option>\n              <option value=\"\'Courier Prime\', monospace\">Courier</option>\n              <option value=\"\'Press Start 2P\', monospace\">Minecraft</option>\n              <option value=\"\'VT323\', monospace\">Retro</option>\n              <option value=\"\'Times New Roman\', serif\">Times</option>\n            </select>\n          </div>\n\n          {/* Font Size */}\n          <div className=\"flex flex-col\">\n            {showLabels && <span className=\"text-[7.5px] font-pixel text-gray-400 px-1 text-center\">SIZE</span>}\n            <div className=\"flex items-center bg-[#2d2d2d] border border-[#555] rounded-none h-6 px-0.5\">\n              <button\n                onClick={() => handleFontSizeChange(-1)}\n                className=\"w-4 h-full flex items-center justify-center text-gray-300 hover:text-white font-bold cursor-pointer\"\n              >\n                -\n              </button>\n              <span className=\"w-5 text-center text-[11px] text-amber-200 font-pixel\">\n                {fontSize}\n              </span>\n              <button\n                onClick={() => handleFontSizeChange(1)}\n                className=\"w-4 h-full flex items-center justify-center text-gray-300 hover:text-white font-bold cursor-pointer\"\n              >\n                +\n              </button>\n            </div>\n          </div>\n        </div>\n\n        {/* Text Style (B, I, U, S) with Names */}\n        <div className=\"flex items-center gap-1 bg-[#252525]/60 p-1 border border-[#444]\">\n          <button\n            onClick={() => onFormat(\'bold\')}\n            className={`mc-button min-w-[30px] h-10 flex flex-col items-center justify-center p-0.5 cursor-pointer ${\n              activeFormats?.[\'bold\'] ? \'border-yellow-400 bg-[#444]\' : \'\'\n            }`}\n            title=\"Bold (Ctrl+B)\"\n          >\n            <span className=\"font-bold text-xs\">B</span>\n            {showLabels && <span className=\"text-[7px] font-pixel text-gray-300\">BOLD</span>}\n          </button>\n          <button\n            onClick={() => onFormat(\'italic\')}\n            className={`mc-button min-w-[30px] h-10 flex flex-col items-center justify-center p-0.5 cursor-pointer ${\n              activeFormats?.[\'italic\'] ? \'border-yellow-400 bg-[#444]\' : \'\'\n            }`}\n            title=\"Italic (Ctrl+I)\"\n          >\n            <span className=\"italic text-xs\">I</span>\n            {showLabels && <span className=\"text-[7px] font-pixel text-gray-300\">ITALIC</span>}\n          </button>\n          <button\n            onClick={() => onFormat(\'underline\')}\n            className={`mc-button min-w-[30px] h-10 flex flex-col items-center justify-center p-0.5 cursor-pointer ${\n              activeFormats?.[\'underline\'] ? \'border-yellow-400 bg-[#444]\' : \'\'\n            }`}\n            title=\"Underline (Ctrl+U)\"\n          >\n            <span className=\"underline text-xs\">U</span>\n            {showLabels && <span className=\"text-[7px] font-pixel text-gray-300\">UNDER</span>}\n          </button>\n          <button\n            onClick={() => onFormat(\'strikeThrough\')}\n            className={`mc-button min-w-[30px] h-10 flex flex-col items-center justify-center p-0.5 cursor-pointer ${\n              activeFormats?.[\'strikethrough\'] ? \'border-yellow-400 bg-[#444]\' : \'\'\n            }`}\n            title=\"Strikethrough\"\n          >\n            <span className=\"line-through text-xs\">S</span>\n            {showLabels && <span className=\"text-[7px] font-pixel text-gray-300\">STRIKE</span>}\n          </button>\n        </div>\n\n        {/* Text Color & Highlight */}\n        <div className=\"flex items-center gap-1 bg-[#252525]/60 p-1 border border-[#444] relative\">\n          {/* Text Color */}\n          <div className=\"relative\">\n            <button\n              onClick={() => {\n                setShowColorPicker(!showColorPicker);\n                setShowHighlightPicker(false);\n                setShowLineSpacing(false);\n              }}\n              className=\"mc-button min-w-[32px] h-10 flex flex-col items-center justify-center p-0.5 cursor-pointer\"\n              title=\"Text Color\"\n            >\n              <div className=\"flex items-center gap-0.5\">\n                <span className=\"font-bold text-xs\">A</span>\n                <div className=\"w-2.5 h-1 bg-red-500 rounded-full\" />\n              </div>\n              {showLabels && <span className=\"text-[7px] font-pixel text-gray-300\">COLOR</span>}\n            </button>\n\n            {showColorPicker && (\n              <div className=\"absolute top-12 left-0 bg-[#222] border-2 border-[#FFD700] p-2 rounded-none shadow-2xl z-50 grid grid-cols-4 gap-1.5 w-44\">\n                {MINECRAFT_COLORS.map((c) => (\n                  <button\n                    key={c.name}\n                    onClick={() => {\n                      onFormat(\'foreColor\', c.color);\n                      setShowColorPicker(false);\n                    }}\n                    className=\"p-1 hover:scale-110 flex items-center justify-center rounded-none border border-[#555] hover:border-white bg-[#333] cursor-pointer\"\n                    title={c.name}\n                  >\n                    <div\n                      className=\"w-4 h-4 rounded-none border border-black\"\n                      style={{ backgroundColor: c.color }}\n                    />\n                  </button>\n                ))}\n              </div>\n            )}\n          </div>\n\n          {/* Highlight Color */}\n          <div className=\"relative\">\n            <button\n              onClick={() => {\n                setShowHighlightPicker(!showHighlightPicker);\n                setShowColorPicker(false);\n                setShowLineSpacing(false);\n              }}\n              className=\"mc-button min-w-[32px] h-10 flex flex-col items-center justify-center p-0.5 cursor-pointer\"\n              title=\"Highlight Glow Color\"\n            >\n              <span className=\"text-xs\">\360\237\226\212\357\270\217</span>\n              {showLabels && <span className=\"text-[7px] font-pixel text-gray-300\">GLOW</span>}\n            </button>\n\n            {showHighlightPicker && (\n              <div className=\"absolute top-12 left-0 bg-[#222] border-2 border-[#FFD700] p-2 rounded-none shadow-2xl z-50 flex flex-col gap-1 w-44\">\n                {HIGHLIGHT_COLORS.map((c) => (\n                  <button\n                    key={c.name}\n                    onClick={() => {\n                      onFormat(\'hiliteColor\', c.color);\n                      setShowHighlightPicker(false);\n                    }}\n                    className=\"p-1.5 hover:bg-[#444] text-left flex items-center gap-2 rounded-none text-xs text-white cursor-pointer\"\n                  >\n                    <span>{c.icon}</span>\n                    <span className=\"text-[11px]\">{c.name}</span>\n                  </button>\n                ))}\n              </div>\n            )}\n          </div>\n        </div>\n\n        {/* Alignment Group */}\n        <div className=\"flex items-center gap-1 bg-[#252525]/60 p-1 border border-[#444]\">\n          <button\n            onClick={() => onFormat(\'justifyLeft\')}\n            className=\"mc-button min-w-[30px] h-10 flex flex-col items-center justify-center p-0.5 cursor-pointer\"\n            title=\"Align Left\"\n          >\n            <span className=\"text-xs\">\360\237\221\210</span>\n            {showLabels && <span className=\"text-[7px] font-pixel text-gray-300\">LEFT</span>}\n          </button>\n          <button\n            onClick={() => onFormat(\'justifyCenter\')}\n            className=\"mc-button min-w-[30px] h-10 flex flex-col items-center justify-center p-0.5 cursor-pointer\"\n            title=\"Align Center\"\n          >\n            <span className=\"text-xs\">\342\206\224\357\270\217</span>\n            {showLabels && <span className=\"text-[7px] font-pixel text-gray-300\">MID</span>}\n          </button>\n          <button\n            onClick={() => onFormat(\'justifyRight\')}\n            className=\"mc-button min-w-[30px] h-10 flex flex-col items-center justify-center p-0.5 cursor-pointer\"\n            title=\"Align Right\"\n          >\n            <span className=\"text-xs\">\360\237\221\211</span>\n            {showLabels && <span className=\"text-[7px] font-pixel text-gray-300\">RIGHT</span>}\n          </button>\n          <button\n            onClick={() => onFormat(\'justifyFull\')}\n            className=\"mc-button min-w-[30px] h-10 flex flex-col items-center justify-center p-0.5 cursor-pointer\"\n            title=\"Justify\"\n          >\n            <span className=\"text-xs\">\360\237\223\204</span>\n            {showLabels && <span className=\"text-[7px] font-pixel text-gray-300\">JUST</span>}\n          </button>\n        </div>\n\n        {/* Lists & Indents */}\n        <div className=\"flex items-center gap-1 bg-[#252525]/60 p-1 border border-[#444]\">\n          <button\n            onClick={() => onFormat(\'insertUnorderedList\')}\n            className=\"mc-button min-w-[30px] h-10 flex flex-col items-center justify-center p-0.5 cursor-pointer\"\n            title=\"Bulleted List\"\n          >\n            <span className=\"text-xs\">\360\237\223\213</span>\n            {showLabels && <span className=\"text-[7px] font-pixel text-gray-300\">BULLET</span>}\n          </button>\n          <button\n            onClick={() => onFormat(\'insertOrderedList\')}\n            className=\"mc-button min-w-[30px] h-10 flex flex-col items-center justify-center p-0.5 cursor-pointer\"\n            title=\"Numbered List\"\n          >\n            <span className=\"text-xs\">\360\237\224\242</span>\n            {showLabels && <span className=\"text-[7px] font-pixel text-gray-300\">NUM</span>}\n          </button>\n          <button\n            onClick={() => onFormat(\'outdent\')}\n            className=\"mc-button min-w-[30px] h-10 flex flex-col items-center justify-center p-0.5 cursor-pointer\"\n            title=\"Decrease Indent\"\n          >\n            <span className=\"text-xs\">\342\254\205\357\270\217</span>\n            {showLabels && <span className=\"text-[7px] font-pixel text-gray-300\">OUT</span>}\n          </button>\n          <button\n            onClick={() => onFormat(\'indent\')}\n            className=\"mc-button min-w-[30px] h-10 flex flex-col items-center justify-center p-0.5 cursor-pointer\"\n            title=\"Increase Indent\"\n          >\n            <span className=\"text-xs\">\342\236\241\357\270\217</span>\n            {showLabels && <span className=\"text-[7px] font-pixel text-gray-300\">IN</span>}\n          </button>\n        </div>\n\n        {/* Media & Insert */}\n        <div className=\"flex items-center gap-1 bg-[#252525]/60 p-1 border border-[#444]\">\n          <button\n            onClick={() => {\n              const url = prompt(\'Enter link URL:\', \'https://\');\n              if (url) onFormat(\'createLink\', url);\n            }}\n            className=\"mc-button min-w-[30px] h-10 flex flex-col items-center justify-center p-0.5 cursor-pointer\"\n            title=\"Insert Link (Ctrl+K)\"\n          >\n            <span className=\"text-xs\">\360\237\222\216</span>\n            {showLabels && <span className=\"text-[7px] font-pixel text-gray-300\">LINK</span>}\n          </button>\n          <button\n            onClick={() => {\n              const url = prompt(\n                \'Enter image URL:\',\n                \'https://images.unsplash.com/photo-1627856013091-fed6e4e30025?w=800&auto=format&fit=crop&q=80\'\n              );\n              if (url) onFormat(\'insertImage\', url);\n            }}\n            className=\"mc-button min-w-[30px] h-10 flex flex-col items-center justify-center p-0.5 cursor-pointer\"\n            title=\"Insert Image\"\n          >\n            <span className=\"text-xs\">\360\237\227\272\357\270\217</span>\n            {showLabels && <span className=\"text-[7px] font-pixel text-gray-300\">IMAGE</span>}\n          </button>\n          {onOpenSpecialCharacters && (\n            <button\n              onClick={onOpenSpecialCharacters}\n              className=\"mc-button min-w-[30px] h-10 flex flex-col items-center justify-center p-0.5 cursor-pointer\"\n              title=\"Insert Minecraft Glyph or Special Symbol\"\n            >\n              <span className=\"text-xs\">\342\234\250</span>\n              {showLabels && <span className=\"text-[7px] font-pixel text-gray-300\">GLYPH</span>}\n            </button>\n          )}\n          <button\n            onClick={() => onFormat(\'removeFormat\')}\n            className=\"mc-button min-w-[30px] h-10 flex flex-col items-center justify-center p-0.5 cursor-pointer\"\n            title=\"Clear Formatting\"\n          >\n            <span className=\"text-xs\">\360\237\247\271</span>\n            {showLabels && <span className=\"text-[7px] font-pixel text-gray-300\">CLEAR</span>}\n          </button>\n        </div>\n      </div>\n\n      {/* Right Controls: Label toggle & Page Setup */}\n      <div className=\"flex items-center gap-2 ml-auto\">\n        <button\n          onClick={() => setShowLabels(!showLabels)}\n          className=\"bg-[#2a2a2a] hover:bg-[#383838] border border-[#555] px-2 py-1 text-[9px] font-pixel text-gray-300 hover:text-white cursor-pointer\"\n          title=\"Toggle text labels on toolbar buttons\"\n        >\n          {showLabels ? \'\360\237\217\267\357\270\217 LABELS ON\' : \'\360\237\217\267\357\270\217 LABELS OFF\'}\n        </button>\n\n        {onOpenPageSetup && (\n          <button\n            onClick={onOpenPageSetup}\n            className=\"mc-button px-2.5 py-1 text-xs font-pixel flex items-center gap-1 text-yellow-300 border-amber-400/60 cursor-pointer\"\n            title=\"Page Size & Layout Setup (A4 Default, White Paper)\"\n          >\n            <span>\360\237\223\204</span>\n            <span className=\"text-[10px] uppercase\">\n              {pageSettings?.pageSize?.toUpperCase() || \'A4\'}\n            </span>\n          </button>\n        )}\n      </div>\n    </header>\n  );\n};\n"
