" />\n                <rect x=\"10\" y=\"6\" width=\"3\" height=\"2\" fill=\"#ffffff\" />\n                <rect x=\"10\" y=\"6\" width=\"2\" height=\"2\" fill=\"#2d52bd\" />\n                {/* Beard/Mouth */}\n                <rect x=\"5\" y=\"10\" width=\"6\" height=\"2\" fill=\"#4d2f1d\" />\n                {/* Shirt */}\n                <rect x=\"2\" y=\"12\" width=\"12\" height=\"4\" fill=\"#00a8a8\" />\n              </svg>\n            )}\n          </div>\n        </div>"
