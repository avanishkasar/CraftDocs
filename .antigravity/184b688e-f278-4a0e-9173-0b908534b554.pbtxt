    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { UserProfile, CharacterType, ThemeMode } from \'../types/editor\';\n\ninterface SignupModalProps {\n  isOpen: boolean;\n  profile: UserProfile;\n  onSaveProfile: (profile: UserProfile) => void;\n  onClose?: () => void;\n}\n\nexport const SignupModal: React.FC<SignupModalProps> = ({\n  isOpen,\n  profile,\n  onSaveProfile,\n  onClose,\n}) => {\n  const [name, setName] = useState(profile.name || \'\');\n  const [character, setCharacter] = useState<CharacterType>(profile.character || \'steve\');\n  const [theme, setTheme] = useState<ThemeMode>(profile.theme || \'day\');\n\n  if (!isOpen) return null;\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    onSaveProfile({\n      name: name.trim() || \'Minecraftian\',\n      character,\n      theme,\n      isSignedUp: true,\n    });\n    if (onClose) onClose();\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm p-4 select-none\">\n      <div className=\"mc-window-dark p-6 max-w-lg w-full shadow-2xl border-4 border-[#FFD700] bg-[#1a1a2e] text-white font-pixel flex flex-col gap-6 animate-achievement\">\n        {/* Title */}\n        <div className=\"text-center border-b-2 border-[#3f3f5a] pb-3\">\n          <div className=\"text-[#FFD700] text-sm tracking-widest uppercase text-shadow mb-1\">\n            \342\232\224\357\270\217 WELCOME TO CRAFTDOCS \342\232\224\357\270\217\n          </div>\n          <p className=\"text-[10px] text-amber-200/80\">\n            Choose your Minecraft Avatar companion and personalize your environment.\n          </p>\n        </div>\n\n        <form onSubmit={handleSubmit} className=\"flex flex-col gap-5\">\n          {/* Player Username */}\n          <div className=\"flex flex-col gap-2\">\n            <label className=\"text-[10px] text-[#FFFF55]\">1. PLAYER USERNAME:</label>\n            <input\n              type=\"text\"\n              value={name}\n              onChange={(e) => setName(e.target.value)}\n              placeholder=\"e.g. Notch, Alex, DiamondMiner99\"\n              required\n              className=\"bg-[#111122] border-2 border-[#555] px-3 py-2 text-xs text-amber-100 placeholder-gray-500 focus:outline-none focus:border-[#FFD700]\"\n            />\n          </div>\n\n          {/* Character Selection (Steve vs Alex) */}\n          <div className=\"flex flex-col gap-2\">\n            <label className=\"text-[10px] text-[#FFFF55]\">2. CHOOSE YOUR AVATAR COMPANION:</label>\n            <div className=\"grid grid-cols-2 gap-4\">\n              {/* STEVE OPTION */}\n              <button\n                type=\"button\"\n                onClick={() => setCharacter(\'steve\')}\n                className={`p-4 border-4 flex flex-col items-center gap-2 cursor-pointer transition-all ${\n                  character === \'steve\'\n                    ? \'bg-[#2a3b5c] border-[#FFD700] shadow-[0_0_15px_#FFD700]\'\n                    : \'bg-[#181828] border-[#444] hover:border-gray-300\'\n                }`}\n              >\n                {/* Pixel Steve Avatar Graphic */}\n                <div className=\"w-16 h-16 bg-[#2a52be] border-2 border-[#000] relative flex items-center justify-center shadow-md\">\n                  {/* Steve Face SVG */}\n                  <svg viewBox=\"0 0 16 16\" className=\"w-14 h-14 image-pixelated\">\n                    {/* Hair */}\n                    <rect x=\"2\" y=\"2\" width=\"12\" height=\"4\" fill=\"#321b0f\" />\n                    {/* Skin */}\n                    <rect x=\"2\" y=\"6\" width=\"12\" height=\"8\" fill=\"#bc8e5f\" />\n                    {/* Eyes */}\n                    <rect x=\"3\" y=\"7\" width=\"3\" height=\"2\" fill=\"#ffffff\" />\n                    <rect x=\"4\" y=\"7\" width=\"2\" height=\"2\" fill=\"#2d52bd\" />\n                    <rect x=\"10\" y=\"7\" width=\"3\" height=\"2\" fill=\"#ffffff\" />\n                    <rect x=\"10\" y=\"7\" width=\"2\" height=\"2\" fill=\"#2d52bd\" />\n                    {/* Nose & Beard/Mouth */}\n                    <rect x=\"7\" y=\"9\" width=\"2\" height=\"2\" fill=\"#9c6d42\" />\n                    <rect x=\"5\" y=\"11\" width=\"6\" height=\"2\" fill=\"#4d2f1d\" />\n                  </svg>\n                </div>\n                <span className=\"text-xs text-[#FFD700]\">STEVE</span>\n                <span className=\"text-[8px] text-gray-300 text-center\">Blue Shirt Classic Hero</span>\n              </button>\n\n              {/* ALEX OPTION */}\n              <button\n                type=\"button\"\n                onClick={() => setCharacter(\'alex\')}\n                className={`p-4 border-4 flex flex-col items-center gap-2 cursor-pointer transition-all ${\n                  character === \'alex\'\n                    ? \'bg-[#2a4d35] border-[#55FF55] shadow-[0_0_15px_#55FF55]\'\n                    : \'bg-[#181828] border-[#444] hover:border-gray-300\'\n                }`}\n              >\n                {/* Pixel Alex Avatar Graphic */}\n                <div className=\"w-16 h-16 bg-[#3d7a42] border-2 border-[#000] relative flex items-center justify-center shadow-md\">\n                  {/* Alex Face SVG */}\n                  <svg viewBox=\"0 0 16 16\" className=\"w-14 h-14 image-pixelated\">\n                    {/* Orange Hair */}\n                    <rect x=\"2\" y=\"2\" width=\"12\" height=\"5\" fill=\"#d66828\" />\n                    {/* Skin */}\n                    <rect x=\"3\" y=\"6\" width=\"10\" height=\"8\" fill=\"#e5b88f\" />\n                    {/* Green Eyes */}\n                    <rect x=\"3\" y=\"7\" width=\"3\" height=\"2\" fill=\"#ffffff\" />\n                    <rect x=\"4\" y=\"7\" width=\"2\" height=\"2\" fill=\"#3b9643\" />\n                    <rect x=\"10\" y=\"7\" width=\"3\" height=\"2\" fill=\"#ffffff\" />\n                    <rect x=\"10\" y=\"7\" width=\"2\" height=\"2\" fill=\"#3b9643\" />\n                    {/* Lips */}\n                    <rect x=\"6\" y=\"11\" width=\"4\" height=\"1\" fill=\"#b86b53\" />\n                  </svg>\n                </div>\n                <span className=\"text-xs text-[#55FF55]\">ALEX</span>\n                <span className=\"text-[8px] text-gray-300 text-center\">Green Tunic Explorer</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Initial Environment Theme */}\n          <div className=\"flex flex-col gap-2\">\n            <label className=\"text-[10px] text-[#FFFF55]\">3. ENVIRONMENT WORLD THEME:</label>\n            <div className=\"grid grid-cols-2 gap-3 text-xs\">\n              <button\n                type=\"button\"\n                onClick={() => setTheme(\'day\')}\n                className={`py-2 px-3 border-2 flex items-center justify-center gap-2 ${\n                  theme === \'day\'\n                    ? \'bg-[#8B6914] text-[#FFFF55] border-[#FFD700]\'\n                    : \'bg-[#222] text-gray-400 border-[#444]\'\n                }`}\n              >\n                <span>\342\230\200\357\270\217 Overworld Day</span>\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => setTheme(\'night\')}\n                className={`py-2 px-3 border-2 flex items-center justify-center gap-2 ${\n                  theme === \'night\'\n                    ? \'bg-[#3b185f] text-[#e082ff] border-[#c042da]\'\n                    : \'bg-[#222] text-gray-400 border-[#444]\'\n                }`}\n              >\n                <span>\360\237\214\231 Nether Night</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Submit Action */}\n          <div className=\"flex items-center justify-between pt-3 border-t border-[#3f3f5a]\">\n            {onClose && (\n              <button\n                type=\"button\"\n                onClick={onClose}\n             