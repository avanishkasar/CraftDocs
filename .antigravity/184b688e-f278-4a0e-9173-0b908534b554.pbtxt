    instruction: "Update minecraft.css to match Geometric Balance design theme styles"
    replacement_infos {
      original_chunk {
        target_content: "/* Minecraft Pixel Theme Styles */\n\n@layer utilities {\n  .font-pixel {\n    font-family: \'Press Start 2P\', monospace;\n  }\n  .font-vt323 {\n    font-family: \'VT323\', monospace;\n  }\n  .font-doc {\n    font-family: \'Courier Prime\', \'Georgia\', serif;\n  }\n}\n\n/* Custom Minecraft Textures & Surfaces */\n\n/* Stone Cobblestone Texture */\n.mc-stone-bg {\n  background-color: #313131;\n  background-image: \n    radial-gradient(#222 15%, transparent 16%),\n    radial-gradient(#444 15%, transparent 16%),\n    linear-gradient(0deg, rgba(0,0,0,0.2) 50%, transparent 50%);\n  background-size: 8px 8px, 8px 8px, 4px 4px;\n  background-position: 0 0, 4px 4px, 0 0;\n  border-bottom: 3px solid #1a1a1a;\n  border-top: 3px solid #555555;\n}\n\n/* Inventory Hotbar Slot */\n.mc-slot {\n  width: 48px;\n  height: 48px;\n  background-color: #8b8b8b;\n  box-shadow: \n    inset 3px 3px 0px #373737,\n    inset -3px -3px 0px #ffffff;\n  border: 2px solid #222222;\n  position: relative;\n  transition: all 0.1s ease;\n  image-rendering: pixelated;\n}\n\n.mc-slot:hover {\n  border-color: #FFD700;\n  box-shadow: \n    inset 3px 3px 0px #4d4d4d,\n    inset -3px -3px 0px #ffffff,\n    0 0 8px rgba(255, 215, 0, 0.6);\n}\n\n.mc-slot.active {\n  background-color: #a8a8a8;\n  border-color: #FFFF55;\n  box-shadow: \n    inset 3px 3px 0px #1a1a1a,\n    inset -3px -3px 0px #ffffff,\n    0 0 12px #FFFF55;\n}\n\n/* Dark Oak Wood Texture for Sidebar */\n.mc-oak-wood-bg {\n  background-color: #2b1d0c;\n  background-image: \n    repeating-linear-gradient(\n      0deg,\n      #2b1d0c,\n      #2b1d0c 12px,\n      #1f1407 12px,\n      #1f1407 24px\n    ),\n    repeating-linear-gradient(\n      90deg,\n      rgba(0, 0, 0, 0.15),\n      rgba(0, 0, 0, 0.15) 1px,\n      transparent 1px,\n      transparent 8px\n    );\n  border-right: 4px solid #120b04;\n}\n\n/* Parchment Book Page Texture */\n.mc-parchment-bg {\n  background-color: #fdf6e3;\n  background-image: \n    radial-gradient(#e0d6be 1px, transparent 1px),\n    linear-gradient(to right, rgba(139, 105, 20, 0.05) 1px, transparent 1px);\n  background-size: 16px 16px, 32px 32px;\n  box-shadow: \n    0 0 0 4px #8B6914,\n    0 0 0 8px #4a370a,\n    8px 8px 16px rgba(0, 0, 0, 0.5);\n  color: #2c2211;\n}\n\n/* Minecraft Container Window Frame */\n.mc-window {\n  background-color: #c6c6c6;\n  border: 4px solid #373737;\n  box-shadow: \n    inset 4px 4px 0px #ffffff,\n    inset -4px -4px 0px #555555,\n    0 8px 24px rgba(0, 0, 0, 0.6);\n}\n\n.mc-window-dark {\n  background-color: #1a1a2e;\n  border: 4px solid #3f3f5a;\n  box-shadow: \n    inset 4px 4px 0px #2a2a40,\n    inset -4px -4px 0px #0e0e1a,\n    0 8px 24px rgba(0, 0, 0, 0.8);\n}\n\n/* Enchanted Item Shimmer Animation */\n@keyframes enchantedGlow {\n  0% {\n    background-position: 0% 50%;\n  }\n  50% {\n    background-position: 100% 50%;\n  }\n  100% {\n    background-position: 0% 50%;\n  }\n}\n\n.mc-enchanted-btn {\n  background: linear-gradient(\n    135deg,\n    #3b185f 0%,\n    #8f2d99 25%,\n    #c042da 50%,\n    #8f2d99 75%,\n    #3b185f 100%\n  );\n  background-size: 200% 200%;\n  animation: enchantedGlow 3s ease infinite;\n  border: 2px solid #e082ff;\n  box-shadow: \n    0 0 10px #c042da,\n    inset 2px 2px 0px #f3a8ff,\n    inset -2px -2px 0px #200838;\n  color: #ffffff;\n  text-shadow: 2px 2px 0px #3b185f;\n}\n\n.mc-enchanted-btn:hover {\n  box-shadow: \n    0 0 18px #f3a8ff,\n    inset 2px 2px 0px #ffffff,\n    inset -2px -2px 0px #200838;\n}\n\n/* Normal Mode Button */\n.mc-button {\n  background-color: #707070;\n  border: 2px solid #000000;\n  box-shadow: \n    inset 2px 2px 0px #aaaaaa,\n    inset -2px -2px 0px #333333;\n  color: #ffffff;\n  text-shadow: 2px 2px 0px #000000;\n  transition: all 0.05s ease;\n}\n\n.mc-button:hover {\n  background-color: #838383;\n  box-shadow: \n    inset 2px 2px 0px #ffffff,\n    inset -2px -2px 0px #222222;\n  color: #ffffa0;\n}\n\n.mc-button:active {\n  box-shadow: \n    inset 2px 2px 0px #222222,\n    inset -2px -2px 0px #838383;\n  transform: translateY(1px);\n}\n\n/* Minecraft Tooltip */\n.mc-tooltip {\n  background-color: #100010;\n  border: 2px solid #280068;\n  box-shadow: 0 0 0 2px #100010;\n  color: #ffffff;\n  font-family: \'Press Start 2P\', monospace;\n  font-size: 10px;\n  line-height: 1.4;\n  padding: 6px 10px;\n  pointer-events: none;\n  z-index: 100;\n}\n\n/* XP Progress Bar */\n.mc-xp-track {\n  background-color: #111111;\n  border: 2px solid #333333;\n  box-shadow: inset 1px 1px 0px #000000;\n}\n\n.mc-xp-fill {\n  background: linear-gradient(180deg, #87ff38 0%, #3bb200 100%);\n  box-shadow: 0 0 6px #87ff38;\n  transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n}"
        replacement_content: "/* Minecraft Pixel Theme Styles - Geometric Balance Theme */\n\n@layer utilities {\n  .font-pixel {\n    font-family: \'Press Start 2P\', monospace;\n  }\n  .font-vt323 {\n    font-family: \'VT323\', monospace;\n  }\n  .font-doc {\n    font-family: \'Georgia\', \'Courier Prime\', serif;\n  }\n}\n\n/* Custom Minecraft Textures & Surfaces - Geometric Balance Theme */\n\n/* Header / Stone Background */\n.mc-stone-bg {\n  background-color: #3f3f3f;\n  background-image: radial-gradient(#4a4a4a 1px, transparent 0);\n  background-size: 4px 4px;\n  border-bottom: 4px solid #111111;\n}\n\n/* Inventory Hotbar Slot */\n.mc-slot {\n  width: 48px;\n  height: 48px;\n  background-color: #2d2d2d;\n  border-width: 4px;\n  border-style: solid;\n  border-color: #555555 #111111 #111111 #555555;\n  box-shadow: inset -2px -2px 0px #111111;\n  position: relative;\n  transition: all 0.1s ease;\n  image-rendering: pixelated;\n}\n\n.mc-slot:hover {\n  border-color: #FFD700;\n  box-shadow: \n    inset -2px -2px 0px #111111,\n    0 0 8px rgba(255, 215, 0, 0.6);\n}\n\n.mc-slot.active {\n  background-color: #3a3a3a;\n  border-color: #FFD700;\n  box-shadow: \n    inset 2px 2px 0px #111111,\n    0 0 12px #FFD700;\n}\n\n/* Dark Oak Wood Texture for Sidebar */\n.mc-oak-wood-bg {\n  background-color: #3b2a1a;\n  background-image: linear-gradient(#2e2012 4px, transparent 0);\n  background-size: 100% 8px;\n  border-right: 4px solid #111111;\n}\n\n/* Parchment Book Page Texture */\n.mc-parchment-bg {\n  background-color: #fdf6e3;\n  border: 6px solid #8B6914;\n  box-shadow: inset 0 0 40px rgba(0,0,0,0.05), 4px 4px 0 #000;\n  color: #2c2211;\n}\n\n/* Minecraft Container Window Frame */\n.mc-window {\n  background-color: #c6c6c6;\n  border: 4px solid #373737;\n  box-shadow: \n    inset 4px 4px 0px #ffffff,\n    inset -4px -4px 0px #555555,\n    0 8px 24px rgba(0, 0, 0, 0.6);\n}\n\n.mc-window-dark {\n  background-color: #1a1a2e;\n  border: 2px solid #3f3f3f;\n  box-shadow: 8px 8px 0 rgba(0,0,0,0.4);\n}\n\n/* Enchanted Item Shimmer Animation */\n@keyframes enchantedGlow {\n  0% {\n    background-position: 0% 50%;\n  }\n  50% {\n    background-position: 100% 50%;\n  }\n  100% {\n    background-position: 0% 50%;\n  }\n}\n\n.mc-enchanted-btn {\n  background: linear-gradient(\n    135deg,\n    #3b185f 0%,\n    #8f2d99 25%,\n    #c042da 50%,\n    #8f2d99 75%,\n    #3b185f 100%\n  );\n  background-size: 200% 200%;\n  animation: enchantedGlow 3s ease infinite;\n  border: 4px solid #e082ff;\n  box-shadow: \n    0 0 10px #c042da,\n    inset -2px -2px 0px #111111;\n  color: #ffffff;\n  text-shadow: 2px 2px 0px #3b185f;\n}\n\n.mc-enchanted-btn:hover {\n  box-shadow: \n    0 0 18px #f3a8ff,\n    inset -2px -2px 0px #ffffff;\n}\n\n/* Normal Mode Button */\n.mc-button {\n  background-color: #2d2d2d;\n  border: 4px solid #555555;\n  box-shadow: inset -2px -2px 0 #111;\n  color: #ffffff;\n  text-shadow: 1px 1px 0px #000000;\n  transition: all 0.05s ease;\n}\n\n.mc-button:hover {\n  background-color: #3d3d3d;\n  border-color: #FFD700;\n  color: #ffffa0;\n}\n\n.mc-button:active {\n  box-shadow: inset 2px 2px 0 #111;\n  transform: translateY(1px);\n}\n\n/* Crafting Green Button */\n.mc-button-green {\n  background-color: #4c7c3c;\n  border-width: 4px;\n  border-style: solid;\n  border-color: #7eb063 #2d4c22 #2d4c22 #7eb063;\n  color: #ffffff;\n  box-shadow: inset -2px -2px 0 #111;\n}\n\n.mc-button-green:hover {\n  background-color: #578c45;\n  border-color: #92cb75 #2d4c22 #2d4c22 #92cb75;\n}\n\n/* Minecraft Tooltip */\n.mc-tooltip {\n  background-color: #100010;\n  border: 2px solid #280068;\n  box-shadow: 0 0 0 2px #100010;\n  color: #ffffff;\n  font-family: \'Press Start 2P\', monospace;\n  font-size: 10px;\n  line-height: 1.4;\n  padding: 6px 10px;\n  pointer-events: none;\n  z-index: 100;\n}\n\n/* XP Progress Bar */\n.mc-xp-track {\n  background-color: #2d2d2d;\n  border: 1px solid #000000;\n}\n\n.mc-xp-fill {\n  background-color: #7cfc00;\n  box-shadow: 0 0 10px #7cfc00;\n  transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n/* Blocky Caret */\n.mc-caret {\n  caret-color: #8B6914;\n}\n\n/* Achievement Popup Keyframe */\n@keyframes slideDownIn {\n  0% {\n    transform: translateY(-100px) scale(0.9);\n    opacity: 0;\n  }\n  70% {\n    transform: translateY(10px) scale(1.02);\n  }\n  100% {\n    transform: translateY(0) scale(1);\n    opacity: 1;\n  }\n}\n\n.animate-achievement {\n  animation: slideDownIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;\n}\n\n/* Custom Scrollbars */\n::-webkit-scrollbar {\n  width: 10px;\n  height: 10px;\n}\n::-webkit-scrollbar-track {\n  background: #1e1e1e;\n  border-left: 2px solid #333;\n}\n::-webkit-scrollbar-thumb {\n  background: #555555;\n  border: 2px solid #222222;\n  box-shadow: inset 1px 1px 0px #777;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: #777777;\n}\n\n/* Content Editable focus resets */\n[contenteditable]:focus {\n  outline: none;\n}"
      }
