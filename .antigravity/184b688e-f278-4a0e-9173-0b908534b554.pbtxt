        lines {
          text: "## \342\232\224\357\270\217 Architecture & Design Decisions"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "### 1. Dual Paradigm Mode Switching"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "- **Survival Mode (Google Docs)**: A continuous `contenteditable` canvas powered by browser Selection API and `document.execCommand` for linear editing."
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "- **Creative Mode (Notion Blocks)**: A block-based editor where each element (paragraph, heading, quote, code, list item, image) is an individual, draggable `Block` component."
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "- **Lossless Conversion**: Switching between modes converts the active page between `Block[]` and HTML seamlessly using a custom DOM parser/converter (`/src/utils/converter.ts`). Content is never lost."
