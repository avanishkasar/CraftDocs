    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "interface ToolbarProps {\n  mode: EditorMode;\n  onToggleMode: () => void;\n  onFormat: (command: string, value?: string) => void;\n  activeFormats?: Record<string, boolean>;\n  onSidebarToggle?: () => void;\n  isSidebarOpen?: boolean;\n  profile?: UserProfile;\n  onOpenProfile?: () => void;\n  onInsertCustomBlock?: (type: string, data?: any) => void;\n}\n\nconst MINECRAFT_COLORS = [\n  { name: \'Redstone Red\', color: \'#ff3333\', icon: \'\360\237\224\264\' },\n  { name: \'Gold Yellow\', color: \'#ffcc00\', icon: \'\360\237\237\241\' },\n  { name: \'Emerald Green\', color: \'#00cc44\', icon: \'\360\237\237\242\' },\n  { name: \'Diamond Cyan\', color: \'#00ffff\', icon: \'\360\237\224\267\' },\n  { name: \'Lapis Blue\', color: \'#3366ff\', icon: \'\360\237\224\265\' },\n  { name: \'Netherite Dark\', color: \'#2b2b2b\', icon: \'\342\254\233\' },\n];\n\nconst HIGHLIGHT_COLORS = [\n  { name: \'Gold Dust\', color: \'#ffff77\', icon: \'\342\234\250\' },\n  { name: \'Emerald Glow\', color: \'#aaffaa\', icon: \'\360\237\237\251\' },\n  { name: \'Diamond Shimmer\', color: \'#bbffff\', icon: \'\360\237\237\246\' },\n  { name: \'Redstone Aura\', color: \'#ffaaaa\', icon: \'\360\237\237\245\' },\n  { name: \'None\', color: \'transparent\', icon: \'\360\237\232\253\' },\n];\n\nexport const Toolbar: React.FC<ToolbarProps> = ({\n  mode,\n  onToggleMode,\n  onFormat,\n  activeFormats = {},\n  onSidebarToggle,\n  isSidebarOpen = true,\n  profile,\n  onOpenProfile,\n  onInsertCustomBlock,\n}) => {\n  const [showColorPicker, setShowColorPicker] = useState(false);\n  const [showHighlightPicker, setShowHighlightPicker] = useState(false);\n  const [showTablePicker, setShowTablePicker] = useState(false);\n\n  // Quick Crafting Table HTML generator\n  const handleInsertTable = (rows: number = 3, cols: number = 3) => {\n    let tableHtml = `<table style=\"width:100%; border-collapse:collapse; margin:12px 0; border:3px solid #8B6914; background-color:#fdf6e3;\"><tbody>`;\n    for (let r = 0; r < rows; r++) {\n      tableHtml += `<tr>`;\n      for (let c = 0; c < cols; c++) {\n        const isHeader = r === 0;\n        const cellTag = isHeader ? \'th\' : \'td\';\n        tableHtml += `<${cellTag} style=\"border:2px solid #8B6914; padding:8px; text-align:left; ${\n          isHeader ? \'background-color:#e0d6be; font-weight:bold;\' : \'\'\n        }\">${isHeader ? `Header ${c + 1}` : `Cell ${r},${c + 1}`}</${cellTag}>`;\n      }\n      tableHtml += `</tr>`;\n    }\n    tableHtml += `</tbody></table><p><br></p>`;\n\n    if (onInsertCustomBlock) {\n      onInsertCustomBlock(\'table\', { rows, cols });\n    } else {\n      onFormat(\'insertHTML\', tableHtml);\n    }\n    setShowTablePicker(false);\n  };\n\n  const textTools = [\n    { id: \'bold\', label: \'Bold (Ctrl+B)\', icon: \'\342\232\224\357\270\217\', cmd: \'bold\' },\n    { id: \'italic\', label: \'Italic (Ctrl+I)\', icon: \'\360\237\223\234\', cmd: \'italic\' },\n    { id: \'underline\', label: \'Underline (Ctrl+U)\', icon: \'\342\234\222\357\270\217\', cmd: \'underline\' },\n    { id: \'strikethrough\', label: \'Strikethrough\', icon: \'\360\237\227\241\357\270\217\', cmd: \'strikeThrough\' },\n    { id: \'subscript\', label: \'Subscript\', icon: \'\342\254\207\357\270\217\', cmd: \'subscript\' },\n    { id: \'superscript\', label: \'Superscript\', icon: \'\342\254\206\357\270\217\', cmd: \'superscript\' },\n  ];\n\n  const alignTools = [\n    { id: \'left\', label: \'Align Left\', icon: \'\360\237\221\210\', cmd: \'justifyLeft\' },\n    { id: \'center\', label: \'Align Center\', icon: \'\342\206\224\357\270\217\', cmd: \'justifyCenter\' },\n    { id: \'right\', label: \'Align Right\', icon: \'\360\237\221\211\', cmd: \'justifyRight\' },\n    { id: \'justify\', label: \'Justify\', icon: \'\360\237\223\204\', cmd: \'justifyFull\' },\n  ];\n\n  const headings = [\n    { id: \'p\', label: \'Normal Text\', icon: \'\360\237\223\235\', cmd: \'formatBlock\', value: \'<p>\' },\n    { id: \'h1\', label: \'Heading 1\', icon: \'\360\237\252\250\', cmd: \'formatBlock\', value: \'<h1>\' },\n    { id: \'h2\', label: \'Heading 2\', icon: \'\360\237\247\261\', cmd: \'formatBlock\', value: \'<h2>\' },\n    { id: \'h3\', label: \'Heading 3\', icon: \'\360\237\223\246\', cmd: \'formatBlock\', value: \'<h3>\' },\n  ];\n\n  return (\n    <header className=\"mc-stone-bg w-full min-h-[56px] px-3 py-1.5 flex flex-wrap items-center justify-between shadow-lg relative z-30 select-none font-pixel gap-2 border-b-4 border-[#111]\">\n      {/* Left Toolbar Items Container */}\n      <div className=\"flex items-center gap-1.5 flex-wrap\">\n        {/* Sidebar / Inventory Toggle */}\n        <button\n          onClick={onSidebarToggle}\n          className=\"mc-slot flex items-center justify-center text-lg shrink-0\"\n          title={isSidebarOpen ? \'Close Inventory Sidebar\' : \'Open Inventory Sidebar\'}\n        >\n          <span>{isSidebarOpen ? \'\360\237\216\222\' : \'\360\237\223\246\'}</span>\n        </button>\n\n        <div className=\"h-7 w-0.5 bg-[#1a1a1a] border-r border-[#555] mx-0.5 shrink-0\" />\n\n        {/* Undo & Redo & Clear Formatting */}\n        <div className=\"flex items-center gap-1 shrink-0\">\n          <button\n            onClick={() => onFormat(\'undo\')}\n            className=\"mc-slot flex items-center justify-center text-sm\"\n            title=\"Undo (Ctrl+Z)\"\n          >\n            \342\206\251\357\270\217\n          </button>\n          <button\n            onClick={() => onFormat(\'redo\')}\n            className=\"mc-slot flex items-center justify-center text-sm\"\n            title=\"Redo (Ctrl+Y)\"\n          >\n            \342\206\252\357\270\217\n          </button>\n          <button\n            onClick={() => onFormat(\'removeFormat\')}\n            className=\"mc-slot flex items-center justify-center text-sm\"\n            title=\"Clear Formatting\"\n          >\n            \360\237\247\271\n          </button>\n        </div>\n\n        <div className=\"h-7 w-0.5 bg-[#1a1a1a] border-r border-[#555] mx-0.5 shrink-0\" />\n\n        {/* Headings Dropdown / Buttons */}\n        <div className=\"flex items-center gap-1 shrink-0\">\n          {headings.map((h) => (\n            <button\n              key={h.id}\n              onClick={() => onFormat(h.cmd, h.value)}\n              className={`mc-slot flex items-center justify-center text-xs px-1 ${\n                activeFormats[h.id] ? \'active\' : \'\'\n              }`}\n              title={h.label}\n            >\n              <span>{h.icon}</span>\n            </button>\n          ))}\n        </div>\n\n        <div className=\"h-7 w-0.5 bg-[#1a1a1a] border-r border-[#555] mx-0.5 shrink-0\" />\n\n        {/* Text Formatting Tools */}\n        <div className=\"flex items-center gap-1 shrink-0\">\n          {textTools.map((tool) => (\n            <button\n              key={tool.id}\n              onClick={() => onFormat(tool.cmd)}\n              className={`mc-slot flex items-center justify-center text-xs ${\n                activeFormats[tool.id] ? \'active\' : \'\'\n              }`}\n              title={tool.label}\n            >\n              <span>{tool.icon}</span>\n            </button>\n          ))}\n        </div>\n\n        <div className=\"h-7 w-0.5 bg-[#1a1a1a] border-r border-[#555] mx-0.5 shrink-0\" />\n\n        {/* Text Dye Colors & Highlight */}\n        <div className=\"flex items-center gap-1 relative shrink-0\">\n          {/* Text Dye Color */}\n          <div className=\"relative\">\n            <button\n              onClick={() => {\n                setShowColorPicker(!showColorPicker);\n                setShowHighlightPicker(false);\n              }}\n              className=\"mc-slot flex items-center justify-center text-xs gap-1 px-1\"\n              title=\"Minecraft Dye Text Color\"\n            >\n              <span>\360\237\216\250</span>\n            </button>\n\n            {showColorPicker && (\n              <div className=\"absolute top-12 left-0 bg-[#1a1a2e] border-4 border-[#FFD700] p-2 rounded shadow-2xl z-50 grid grid-cols-3 gap-1.5 w-36\">\n                {MINECRAFT_COLORS.map((c) => (\n                  <button\n                    key={c.name}\n                    onClick={() => {\n                      onFormat(\'foreColor\', c.color);\n                      setShowColorPicker(false);\n                    }}\n                    className=\"w-8 h-8 rounded border-2 border-black flex items-center justify-center hover:scale-110\"\n                    style={{ backgroundColor: c.color }}\n                    title={c.name}\n                  >\n                    <span className=\"text-xs\">{c.icon}</span>\n                  </button>\n                ))}\n              </div>\n            )}\n          </div>\n\n          {/* Highlight Color */}\n          <div className=\"relative\">\n            <button\n              onClick={() => {\n                setShowHighlightPicker(!showHighlightPicker);\n                setShowColorPicker(false);\n              }}\n              className=\"mc-slot flex items-center justify-center text-xs px-1\"\n              title=\"Text Highlight Color\"\n            >\n              <span>\342\234\250</span>\n            </button>\n\n            {showHighlightPicker && (\n              <div className=\"absolute top-12 left-0 bg-[#1a1a2e] border-4 border-[#FFD700] p-2 rounded shadow-2xl z-50 flex flex-col gap-1 w-36\">\n                {HIGHLIGHT_COLORS.map((c) => (\n                  <button\n                    key={c.name}\n                    onClick={() => {\n                      onFormat(\'hiliteColor\', c.color);\n                      setShowHighlightPicker(false);\n                    }}\n                    className=\"px-2 py-1 text-[10px] text-white bg-[#2a2a40] border border-[#555] hover:border-[#FFD700] flex items-center gap-2\"\n                  >\n                    <span>{c.icon}</span>\n                    <span>{c.name}</span>\n                  </button>\n                ))}\n              </div>\n            )}\n          </div>\n        </div>\n\n        <div className=\"h-7 w-0.5 bg-[#1a1a1a] border-r border-[#555] mx-0.5 shrink-0\" />\n\n        {/* Alignment Tools */}\n        <div className=\"flex items-center gap-1 shrink-0\">\n          {alignTools.map((a) => (\n            <button\n              key={a.id}\n              onClick={() => onFormat(a.cmd)}\n              className=\"mc-slot flex items-center justify-center text-xs\"\n              title={a.label}\n            >\n              <span>{a.icon}</span>\n            </button>\n          ))}\n        </div>\n\n        <div className=\"h-7 w-0.5 bg-[#1a1a1a] border-r border-[#555] mx-0.5 shrink-0\" />\n\n        {/* Lists & Notion Insert Block Tools */}\n        <div className=\"flex items-center gap-1 shrink-0\">\n          <button\n            onClick={() => onFormat(\'insertUnorderedList\')}\n            className=\"mc-slot flex items-center justify-center text-xs\"\n            title=\"Bullet List\"\n          >\n            \360\237\223\213\n          </button>\n          <button\n            onClick={() => onFormat(\'insertOrderedList\')}\n            className=\"mc-slot flex items-center justify-center text-xs\"\n            title=\"Numbered List\"\n          >\n            \360\237\224\242\n          </button>\n\n          {/* Crafting Table Inserter */}\n          <div className=\"relative\">\n            <button\n              onClick={() => setShowTablePicker(!showTablePicker)}\n              className=\"mc-slot flex items-center justify-center text-xs\"\n              title=\"Insert 3x3 Crafting Table\"\n            >\n              \360\237\247\261\n            </button>\n\n            {showTablePicker && (\n              <div className=\"absolute top-12 left-0 bg-[#1a1a2e] border-4 border-[#FFD700] p-3 rounded shadow-2xl z-50 flex flex-col gap-2 w-48 text-white text-xs\">\n                <div className=\"font-bold text-[#FFD700] text-[10px] uppercase\">\n                  Crafting Grid Table\n                </div>\n                <div className=\"grid grid-cols-3 gap-1\">\n                  <button\n                    onClick={() => handleInsertTable(2, 2)}\n                    className=\"mc-button p-1 text-[9px]\"\n                  >\n                    2x2 Grid\n                  </button>\n                  <button\n                    onClick={() => handleInsertTable(3, 3)}\n                    className=\"mc-button p-1 text-[9px]\"\n                  >\n                    3x3 Grid\n                  </button>\n                  <button\n                    onClick={() => handleInsertTable(4, 4)}\n                    className=\"mc-button p-1 text-[9px]\"\n                  >\n                    4x4 Grid\n                  </button>\n                </div>\n              </div>\n            )}\n          </div>\n\n          {/* Quote & Code Block */}\n          <button\n            onClick={() => onFormat(\'formatBlock\', \'blockquote\')}\n            className=\"mc-slot flex items-center justify-center text-xs\"\n            title=\"Minecraft Callout Quote\"\n          >\n            \360\237\222\254\n          </button>\n          <button\n            onClick={() => onFormat(\'formatBlock\', \'<pre>\')}\n            className=\"mc-slot flex items-center justify-center text-xs\"\n            title=\"Redstone Code Block\"\n          >\n            \360\237\222\273\n          </button>\n          <button\n            onClick={() => onFormat(\'insertHorizontalRule\')}\n            className=\"mc-slot flex items-center justify-center text-xs\"\n            title=\"Horizontal Divider Line\"\n          >\n            \342\236\226\n          </button>\n\n          {/* Link & Image */}\n          <button\n            onClick={() => {\n              const url = prompt(\'Enter Minecraft Redstone URL:\', \'https://\');\n              if (url) onFormat(\'createLink\', url);\n            }}\n            className=\"mc-slot flex items-center justify-center text-xs\"\n            title=\"Insert Link\"\n          >\n            \360\237\222\216\n          </button>\n          <button\n            onClick={() => {\n              const url = prompt(\n                \'Enter Image / Map Texture URL:\',\n                \'https://images.unsplash.com/photo-1627856013091-fed6e4e30025?w=800&auto=format&fit=crop&q=80\'\n              );\n              if (url) onFormat(\'insertImage\', url);\n            }}\n            className=\"mc-slot flex items-center justify-center text-xs\"\n            title=\"Insert Map / Image Texture\"\n          >\n            \360\237\227\272\357\270\217\n          </button>\n        </div>\n      </div>\n\n      {/* Right Controls: Mode Toggle & Profile Button */}\n      <div className=\"flex items-center gap-2 shrink-0 ml-auto\">\n        {profile && onOpenProfile && (\n          <button\n            onClick={onOpenProfile}\n            className=\"mc-button px-2 py-1 text-xs flex items-center gap-1.5 text-amber-200 border-[#FFD700]\"\n            title=\"Profile & Character Settings\"\n          >\n            <span>{profile.character === \'alex\' ? \'\360\237\237\251\' : \'\360\237\237\246\'}</span>\n            <span className=\"hidden sm:inline text-[10px] uppercase font-bold\">\n              {profile.name}\n            </span>\n          </button>\n        )}\n\n        <ModeToggle mode={mode} onToggle={onToggleMode} />\n      </div>\n    </header>\n  );\n};"
      replacement_content: "interface ToolbarProps {\n  mode: EditorMode;\n  onToggleMode: () => void;\n  onFormat: (command: string, value?: string) => void;\n  activeFormats?: Record<string, boolean>;\n  onSidebarToggle?: () => void;\n  isSidebarOpen?: boolean;\n  profile?: UserProfile;\n  onOpenProfile?: () => void;\n  onOpenSettings?: () => void;\n  onInsertCustomBlock?: (type: string, data?: any) => void;\n}\n\nconst MINECRAFT_COLORS = [\n  { name: \'Redstone Red\', color: \'#ff3333\', icon: \'\360\237\224\264\' },\n  { name: \'Gold Yellow\', color: \'#ffcc00\', icon: \'\360\237\237\241\' },\n  { name: \'Emerald Green\', color: \'#00cc44\', icon: \'\360\237\237\242\' },\n  { name: \'Diamond Cyan\', color: \'#00ffff\', icon: \'\360\237\224\267\' },\n  { name: \'Lapis Blue\', color: \'#3366ff\', icon: \'\360\237\224\265\' },\n  { name: \'Netherite Dark\', color: \'#2b2b2b\', icon: \'\342\254\233\' },\n];\n\nconst HIGHLIGHT_COLORS = [\n  { name: \'Gold Dust\', color: \'#ffff77\', icon: \'\342\234\250\' },\n  { name: \'Emerald Glow\', color: \'#aaffaa\', icon: \'\360\237\237\251\' },\n  { name: \'Diamond Shimmer\', color: \'#bbffff\', icon: \'\360\237\237\246\' },\n  { name: \'Redstone Aura\', color: \'#ffaaaa\', icon: \'\360\237\237\245\' },\n  { name: \'None\', color: \'transparent\', icon: \'\360\237\232\253\' },\n];\n\nexport const Toolbar: React.FC<ToolbarProps> = ({\n  mode,\n  onToggleMode,\n  onFormat,\n  activeFormats = {},\n  onSidebarToggle,\n  isSidebarOpen = true,\n  profile,\n  onOpenProfile,\n  onOpenSettings,\n  onInsertCustomBlock,\n}) => {\n  const [showColorPicker, setShowColorPicker] = useState(false);\n  const [showHighlightPicker, setShowHighlightPicker] = useState(false);\n  const [showTablePicker, setShowTablePicker] = useState(false);\n\n  // Quick Crafting Table HTML generator\n  const handleInsertTable = (rows: number = 3, cols: number = 3) => {\n    let tableHtml = `<table style=\"width:100%; border-collapse:collapse; margin:12px 0; border:3px solid #8B6914; background-color:#fdf6e3;\"><tbody>`;\n    for (let r = 0; r < rows; r++) {\n      tableHtml += `<tr>`;\n      for (let c = 0; c < cols; c++) {\n        const isHeader = r === 0;\n        const cellTag = isHeader ? \'th\' : \'td\';\n        tableHtml += `<${cellTag} style=\"border:2px solid #8B6914; padding:8px; text-align:left; ${\n          isHeader ? \'background-color:#e0d6be; font-weight:bold;\' : \'\'\n        }\">${isHeader ? `Header ${c + 1}` : `Cell ${r},${c + 1}`}</${cellTag}>`;\n      }\n      tableHtml += `</tr>`;\n    }\n    tableHtml += `</tbody></table><p><br></p>`;\n\n    if (onInsertCustomBlock) {\n      onInsertCustomBlock(\'table\', { rows, cols });\n    } else {\n      onFormat(\'insertHTML\', tableHtml);\n    }\n    setShowTablePicker(false);\n  };\n\n  const textTools = [\n    { id: \'bold\', name: \'Bold\', label: \'Bold (Ctrl+B)\', icon: \'\342\232\224\357\270\217\', cmd: \'bold\' },\n    { id: \'italic\', name: \'Italic\', label: \'Italic (Ctrl+I)\', icon: \'\360\237\223\234\', cmd: \'italic\' },\n    { id: \'underline\', name: \'Under\', label: \'Underline (Ctrl+U)\', icon: \'\342\234\222\357\270\217\', cmd: \'underline\' },\n    { id: \'strikethrough\', name: \'Strike\', label: \'Strikethrough\', icon: \'\360\237\227\241\357\270\217\', cmd: \'strikeThrough\' },\n    { id: \'subscript\', name: \'Sub\', label: \'Subscript\', icon: \'\342\254\207\357\270\217\', cmd: \'subscript\' },\n    { id: \'superscript\', name: \'Super\', label: \'Superscript\', icon: \'\342\254\206\357\270\217\', cmd: \'superscript\' },\n  ];\n\n  const alignTools = [\n    { id: \'left\', name: \'Left\', label: \'Align Left\', icon: \'\360\237\221\210\', cmd: \'justifyLeft\' },\n    { id: \'center\', name: \'Center\', label: \'Align Center\', icon: \'\342\206\224\357\270\217\', cmd: \'justifyCenter\' },\n    { id: \'right\', name: \'Right\', label: \'Align Right\', icon: \'\360\237\221\211\', cmd: \'justifyRight\' },\n    { id: \'justify\', name: \'Justify\', label: \'Justify Text\', icon: \'\360\237\223\204\', cmd: \'justifyFull\' },\n  ];\n\n  const headings = [\n    { id: \'p\', name: \'Text\', label: \'Normal Text\', icon: \'\360\237\223\235\', cmd: \'formatBlock\', value: \'<p>\' },\n    { id: \'h1\', name: \'H1\', label: \'Heading 1\', icon: \'\360\237\252\250\', cmd: \'formatBlock\', value: \'<h1>\' },\n    { id: \'h2\', name: \'H2\', label: \'Heading 2\', icon: \'\360\237\247\261\', cmd: \'formatBlock\', value: \'<h2>\' },\n    { id: \'h3\', name: \'H3\', label: \'Heading 3\', icon: \'\360\237\223\246\', cmd: \'formatBlock\', value: \'<h3>\' },\n  ];\n\n  return (\n    <header className=\"mc-stone-bg w-full min-h-[64px] px-3 py-1.5 flex flex-wrap items-center justify-between shadow-lg relative z-30 select-none font-pixel gap-2 border-b-4 border-[#111]\">\n      {/* Left Toolbar Items Container */}\n      <div className=\"flex items-center gap-1 flex-wrap\">\n        {/* Sidebar / Inventory Toggle */}\n        <button\n          onClick={onSidebarToggle}\n          className=\"mc-slot flex flex-col items-center justify-center min-w-[44px] h-[48px] px-1 py-0.5 text-xs shrink-0\"\n          title={isSidebarOpen ? \'Close Inventory Sidebar\' : \'Open Inventory Sidebar\'}\n        >\n          <span className=\"text-base\">{isSidebarOpen ? \'\360\237\216\222\' : \'\360\237\223\246\'}</span>\n          <span className=\"text-[8px] text-amber-200 mt-0.5 uppercase tracking-tight\">Sidebar</span>\n        </button>\n\n        <div className=\"h-8 w-0.5 bg-[#1a1a1a] border-r border-[#555] mx-0.5 shrink-0\" />\n\n        {/* Undo & Redo & Clear Formatting */}\n        <div className=\"flex items-center gap-1 shrink-0\">\n          <button\n            onClick={() => onFormat(\'undo\')}\n            className=\"mc-slot flex flex-col items-center justify-center min-w-[40px] h-[48px] px-1 py-0.5\"\n            title=\"Undo (Ctrl+Z)\"\n          >\n            <span className=\"text-xs\">\342\206\251\357\270\217</span>\n            <span className=\"text-[8px] text-gray-200 mt-0.5\">Undo</span>\n          </button>\n          <button\n            onClick={() => onFormat(\'redo\')}\n            className=\"mc-slot flex flex-col items-center justify-center min-w-[40px] h-[48px] px-1 py-0.5\"\n            title=\"Redo (Ctrl+Y)\"\n          >\n            <span className=\"text-xs\">\342\206\252\357\270\217</span>\n            <span className=\"text-[8px] text-gray-200 mt-0.5\">Redo</span>\n          </button>\n          <button\n            onClick={() => onFormat(\'removeFormat\')}\n            className=\"mc-slot flex flex-col items-center justify-center min-w-[40px] h-[48px] px-1 py-0.5\"\n            title=\"Clear Formatting\"\n          >\n            <span className=\"text-xs\">\360\237\247\271</span>\n            <span className=\"text-[8px] text-gray-200 mt-0.5\">Clear</span>\n          </button>\n        </div>\n\n        <div className=\"h-8 w-0.5 bg-[#1a1a1a] border-r border-[#555] mx-0.5 shrink-0\" />\n\n        {/* Headings Buttons */}\n        <div className=\"flex items-center gap-1 shrink-0\">\n          {headings.map((h) => (\n            <button\n              key={h.id}\n              onClick={() => onFormat(h.cmd, h.value)}\n              className={`mc-slot flex flex-col items-center justify-center min-w-[38px] h-[48px] px-1 py-0.5 ${\n                activeFormats[h.id] ? \'active\' : \'\'\n              }`}\n              title={h.label}\n            >\n              <span className=\"text-xs\">{h.icon}</span>\n              <span className=\"text-[8px] text-gray-200 mt-0.5\">{h.name}</span>\n            </button>\n          ))}\n        </div>\n\n        <div className=\"h-8 w-0.5 bg-[#1a1a1a] border-r border-[#555] mx-0.5 shrink-0\" />\n\n        {/* Text Formatting Tools */}\n        <div className=\"flex items-center gap-1 shrink-0\">\n          {textTools.map((tool) => (\n            <button\n              key={tool.id}\n              onClick={() => onFormat(tool.cmd)}\n              className={`mc-slot flex flex-col items-center justify-center min-w-[40px] h-[48px] px-1 py-0.5 ${\n                activeFormats[tool.id] ? \'active\' : \'\'\n              }`}\n              title={tool.label}\n            >\n              <span className=\"text-xs\">{tool.icon}</span>\n              <span className=\"text-[8px] text-gray-200 mt-0.5\">{tool.name}</span>\n            </button>\n          ))}\n        </div>\n\n        <div className=\"h-8 w-0.5 bg-[#1a1a1a] border-r border-[#555] mx-0.5 shrink-0\" />\n\n        {/* Text Dye Colors & Highlight */}\n        <div className=\"flex items-center gap-1 relative shrink-0\">\n          {/* Text Dye Color */}\n          <div className=\"relative\">\n            <button\n              onClick={() => {\n                setShowColorPicker(!showColorPicker);\n                setShowHighlightPicker(false);\n              }}\n              className=\"mc-slot flex flex-col items-center justify-center min-w-[42px] h-[48px] px-1 py-0.5\"\n              title=\"Minecraft Dye Text Color\"\n            >\n              <span className=\"text-xs\">\360\237\216\250</span>\n              <span className=\"text-[8px] text-gray-200 mt-0.5\">Dye Color</span>\n            </button>\n\n            {showColorPicker && (\n              <div className=\"absolute top-14 left-0 bg-[#1a1a2e] border-4 border-[#FFD700] p-2 rounded shadow-2xl z-50 grid grid-cols-3 gap-1.5 w-36\">\n                {MINECRAFT_COLORS.map((c) => (\n                  <button\n                    key={c.name}\n                    onClick={() => {\n                      onFormat(\'foreColor\', c.color);\n                      setShowColorPicker(false);\n                    }}\n                    className=\"w-8 h-8 rounded border-2 border-black flex items-center justify-center hover:scale-110\"\n                    style={{ backgroundColor: c.color }}\n                    title={c.name}\n                  >\n                    <span className=\"text-xs\">{c.icon}</span>\n                  </button>\n                ))}\n              </div>\n            )}\n          </div>\n\n          {/* Highlight Color */}\n          <div className=\"relative\">\n            <button\n              onClick={() => {\n                setShowHighlightPicker(!showHighlightPicker);\n                setShowColorPicker(false);\n              }}\n              className=\"mc-slot flex flex-col items-center justify-center min-w-[42px] h-[48px] px-1 py-0.5\"\n              title=\"Text Highlight Color\"\n            >\n              <span className=\"text-xs\">\342\234\250</span>\n              <span className=\"text-[8px] text-gray-200 mt-0.5\">Glow</span>\n            </button>\n\n            {showHighlightPicker && (\n              <div className=\"absolute top-14 left-0 bg-[#1a1a2e] border-4 border-[#FFD700] p-2 rounded shadow-2xl z-50 flex flex-col gap-1 w-36\">\n                {HIGHLIGHT_COLORS.map((c) => (\n                  <button\n                    key={c.name}\n                    onClick={() => {\n                      onFormat(\'hiliteColor\', c.color);\n                      setShowHighlightPicker(false);\n                    }}\n                    className=\"px-2 py-1 text-[10px] text-white bg-[#2a2a40] border border-[#555] hover:border-[#FFD700] flex items-center gap-2\"\n                  >\n                    <span>{c.icon}</span>\n                    <span>{c.name}</span>\n                  </button>\n                ))}\n              </div>\n            )}\n          </div>\n        </div>\n\n        <div className=\"h-8 w-0.5 bg-[#1a1a1a] border-r border-[#555] mx-0.5 shrink-0\" />\n\n        {/* Alignment Tools */}\n        <div className=\"flex items-center gap-1 shrink-0\">\n          {alignTools.map((a) => (\n            <button\n              key={a.id}\n              onClick={() => onFormat(a.cmd)}\n              className=\"mc-slot flex flex-col items-center justify-center min-w-[40px] h-[48px] px-1 py-0.5\"\n              title={a.label}\n            >\n              <span className=\"text-xs\">{a.icon}</span>\n              <span className=\"text-[8px] text-gray-200 mt-0.5\">{a.name}</span>\n            </button>\n          ))}\n        </div>\n\n        <div className=\"h-8 w-0.5 bg-[#1a1a1a] border-r border-[#555] mx-0.5 shrink-0\" />\n\n        {/* Lists & Notion Insert Block Tools */}\n        <div className=\"flex items-center gap-1 shrink-0\">\n          <button\n            onClick={() => onFormat(\'insertUnorderedList\')}\n            className=\"mc-slot flex flex-col items-center justify-center min-w-[40px] h-[48px] px-1 py-0.5\"\n            title=\"Bullet List\"\n          >\n            <span className=\"text-xs\">\360\237\223\213</span>\n            <span className=\"text-[8px] text-gray-200 mt-0.5\">Bullets</span>\n          </button>\n          <button\n            onClick={() => onFormat(\'insertOrderedList\')}\n            className=\"mc-slot flex flex-col items-center justify-center min-w-[40px] h-[48px] px-1 py-0.5\"\n            title=\"Numbered List\"\n          >\n            <span className=\"text-xs\">\360\237\224\242</span>\n            <span className=\"text-[8px] text-gray-200 mt-0.5\">Numbers</span>\n          </button>\n\n          {/* Crafting Table Inserter */}\n          <div className=\"relative\">\n            <button\n              onClick={() => setShowTablePicker(!showTablePicker)}\n              className=\"mc-slot flex flex-col items-center justify-center min-w-[42px] h-[48px] px-1 py-0.5\"\n              title=\"Insert Crafting Table\"\n            >\n              <span className=\"text-xs\">\360\237\247\261</span>\n              <span className=\"text-[8px] text-gray-200 mt-0.5\">Table</span>\n            </button>\n\n            {showTablePicker && (\n              <div className=\"absolute top-14 left-0 bg-[#1a1a2e] border-4 border-[#FFD700] p-3 rounded shadow-2xl z-50 flex flex-col gap-2 w-48 text-white text-xs\">\n                <div className=\"font-bold text-[#FFD700] text-[10px] uppercase\">\n                  Crafting Grid Table\n                </div>\n                <div className=\"grid grid-cols-3 gap-1\">\n                  <button\n                    onClick={() => handleInsertTable(2, 2)}\n                    className=\"mc-button p-1 text-[9px]\"\n                  >\n                    2x2 Grid\n                  </button>\n                  <button\n                    onClick={() => handleInsertTable(3, 3)}\n                    className=\"mc-button p-1 text-[9px]\"\n                  >\n                    3x3 Grid\n                  </button>\n                  <button\n                    onClick={() => handleInsertTable(4, 4)}\n                    className=\"mc-button p-1 text-[9px]\"\n                  >\n                    4x4 Grid\n                  </button>\n                </div>\n              </div>\n            )}\n          </div>\n\n          {/* Quote & Code Block */}\n          <button\n            onClick={() => onFormat(\'formatBlock\', \'blockquote\')}\n            className=\"mc-slot flex flex-col items-center justify-center min-w-[40px] h-[48px] px-1 py-0.5\"\n            title=\"Minecraft Callout Quote\"\n          >\n            <span className=\"text-xs\">\360\237\222\254</span>\n            <span className=\"text-[8px] text-gray-200 mt-0.5\">Quote</span>\n          </button>\n          <button\n            onClick={() => onFormat(\'formatBlock\', \'<pre>\')}\n            className=\"mc-slot flex flex-col items-center justify-center min-w-[40px] h-[48px] px-1 py-0.5\"\n            title=\"Redstone Code Block\"\n          >\n            <span className=\"text-xs\">\360\237\222\273</span>\n            <span className=\"text-[8px] text-gray-200 mt-0.5\">Code</span>\n          </button>\n          <button\n            onClick={() => onFormat(\'insertHorizontalRule\')}\n            className=\"mc-slot flex flex-col items-center justify-center min-w-[40px] h-[48px] px-1 py-0.5\"\n            title=\"Horizontal Divider Line\"\n          >\n            <span className=\"text-xs\">\342\236\226</span>\n            <span className=\"text-[8px] text-gray-200 mt-0.5\">Divider</span>\n          </button>\n\n          {/* Link & Image */}\n          <button\n            onClick={() => {\n              const url = prompt(\'Enter Minecraft Redstone URL:\', \'https://\');\n              if (url) onFormat(\'createLink\', url);\n            }}\n            className=\"mc-slot flex flex-col items-center justify-center min-w-[40px] h-[48px] px-1 py-0.5\"\n            title=\"Insert Link\"\n          >\n            <span className=\"text-xs\">\360\237\222\216</span>\n            <span className=\"text-[8px] text-gray-200 mt-0.5\">Link</span>\n          </button>\n          <button\n            onClick={() => {\n              const url = prompt(\n                \'Enter Image / Map Texture URL:\',\n                \'https://images.unsplash.com/photo-1627856013091-fed6e4e30025?w=800&auto=format&fit=crop&q=80\'\n              );\n              if (url) onFormat(\'insertImage\', url);\n            }}\n            className=\"mc-slot flex flex-col items-center justify-center min-w-[40px] h-[48px] px-1 py-0.5\"\n            title=\"Insert Map / Image Texture\"\n          >\n            <span className=\"text-xs\">\360\237\227\272\357\270\217</span>\n            <span className=\"text-[8px] text-gray-200 mt-0.5\">Image</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Right Controls: Mode Toggle, Settings Window & Profile Button */}\n      <div className=\"flex items-center gap-2 shrink-0 ml-auto\">\n        {/* Settings Window Button */}\n        {(onOpenSettings || onOpenProfile) && (\n          <button\n            onClick={onOpenSettings || onOpenProfile}\n            className=\"mc-button px-2.5 py-1.5 text-xs flex items-center gap-1.5 text-yellow-300 border-[#FFD700]\"\n            title=\"Open CraftDocs Settings Window\"\n          >\n            <span className=\"text-sm\">\342\232\231\357\270\217</span>\n            <span className=\"hidden md:inline text-[10px] font-bold uppercase\">Settings</span>\n          </button>\n        )}\n\n        {profile && onOpenProfile && (\n          <button\n            onClick={onOpenProfile}\n            className=\"mc-button px-2 py-1.5 text-xs flex items-center gap-1.5 text-amber-200 border-[#FFD700]\"\n            title=\"Profile & Character Settings\"\n          >\n            <span>{profile.character === \'alex\' ? \'\360\237\237\251\' : \'\360\237\237\246\'}</span>\n            <span className=\"hidden sm:inline text-[10px] uppercase font-bold\">\n              {profile.name}\n            </span>\n          </button>\n        )}\n\n        <ModeToggle mode={mode} onToggle={onToggleMode} />\n      </div>\n    </header>\n  );\n};"
