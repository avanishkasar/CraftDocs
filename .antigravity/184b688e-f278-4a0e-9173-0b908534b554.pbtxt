        replacement_content: "/* Parchment Book Page Texture */\n.mc-parchment-bg {\n  background-color: #fdf6e3;\n  border: 6px solid #8B6914;\n  box-shadow: inset 0 0 40px rgba(0,0,0,0.05), 4px 4px 0 #000;\n  color: #2c2211;\n}\n\n/* Nether Obsidian Night Parchment */\n.mc-night-parchment {\n  background-color: #121224;\n  background-image: radial-gradient(#252545 1px, transparent 0);\n  background-size: 8px 8px;\n  border: 6px solid #c042da;\n  box-shadow: inset 0 0 50px rgba(192, 66, 218, 0.15), 4px 4px 0 #000;\n  color: #f0e6ff;\n}\n\n.mc-night-parchment input,\n.mc-night-parchment div[contenteditable] {\n  color: #f0e6ff !important;\n}"
      }
