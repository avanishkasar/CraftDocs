    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Page } from \'../types/editor\';\n\ninterface SidebarProps {\n  pages: Page[];\n  activePageId: string | null;\n  onSelectPage: (id: string) => void;\n  onCreatePage: (parentId?: string | null, title?: string, icon?: string) => void;\n  onRenamePage: (id: string, title: string) => void;\n  onDuplicatePage: (id: string) => void;\n  onDeletePage: (id: string) => void;\n  onMovePage: (id: string, newParentId: string | null) => void;\n  isOpen: boolean;\n  onCloseMobile?: () => void;\n}\n\nexport const Sidebar: React.FC<SidebarProps> = ({\n  pages,\n  activePageId,\n  onSelectPage,\n  onCreatePage,\n  onRenamePage,\n  onDuplicatePage,\n  onDeletePage,\n  onMovePage,\n  isOpen,\n  onCloseMobile,\n}) => {\n  const [searchTerm, setSearchTerm] = useState(\'\');\n  const [editingId, setEditingId] = useState<string | null>(null);\n  const [editingTitle, setEditingTitle] = useState(\'\');\n  const [collapsedIds, setCollapsedIds] = useState<Record<string, boolean>>({});\n  const [contextMenu, setContextMenu] = useState<{ id: string; x: number; y: number } | null>(null);\n  const [draggedPageId, setDraggedPageId] = useState<string | null>(null);\n\n  // Group pages by parentId\n  const rootPages = pages.filter((p) => !p.parentId);\n\n  const getChildren = (parentId: string) => pages.filter((p) => p.parentId === parentId);\n\n  const toggleCollapse = (id: string, e: React.MouseEvent) => {\n    e.stopPropagation();\n    setCollapsedIds((prev) => ({ ...prev, [id]: !prev[id] }));\n  };\n\n  const handleStartRename = (page: Page, e?: React.MouseEvent) => {\n    e?.stopPropagation();\n    setEditingId(page.id);\n    setEditingTitle(page.title);\n    setContextMenu(null);\n  };\n\n  const handleSaveRename = (id: string) => {\n    if (editingTitle.trim()) {\n      onRenamePage(id, editingTitle.trim());\n    }\n    setEditingId(null);\n  };\n\n  const handleKeyDownRename = (e: React.KeyboardEvent, id: string) => {\n    if (e.key === \'Enter\') {\n      handleSaveRename(id);\n    } else if (e.key === \'Escape\') {\n      setEditingId(null);\n    }\n  };\n\n  const handleContextMenu = (e: React.MouseEvent, id: string) => {\n    e.preventDefault();\n    setContextMenu({ id, x: e.clientX, y: e.clientY });\n  };\n\n  // Drag and Drop handlers\n  const handleDragStart = (e: React.DragEvent, id: string) => {\n    e.stopPropagation();\n    setDraggedPageId(id);\n    e.dataTransfer.setData(\'text/plain\', id);\n  };\n\n  const handleDragOver = (e: React.DragEvent) => {\n    e.preventDefault();\n    e.dataTransfer.dropEffect = \'move\';\n  };\n\n  const handleDropOnPage = (e: React.DragEvent, targetId: string) => {\n    e.preventDefault();\n    e.stopPropagation();\n    if (draggedPageId && draggedPageId !== targetId) {\n      onMovePage(draggedPageId, targetId);\n    }\n    setDraggedPageId(null);\n  };\n\n  const handleDropOnRoot = (e: React.DragEvent) => {\n    e.preventDefault();\n    if (draggedPageId) {\n      onMovePage(draggedPageId, null);\n    }\n    setDraggedPageId(null);\n  };\n\n  // Filter pages by search term\n  const filteredPages = pages.filter((p) =>\n    p.title.toLowerCase().includes(searchTerm.toLowerCase())\n  );\n\n  const renderPageTree = (pageList: Page[], depth: number = 0) => {\n    return pageList.map((page) => {\n      const children = getChildren(page.id);\n      const hasChildren = children.length > 0;\n      const isCollapsed = collapsedIds[page.id];\n      const isActive = page.id === activePageId;\n      const isEditing = editingId === page.id;\n\n      return (\n        <div key={page.id} className=\"flex flex-col\">\n          <div\n            draggable={!isEditing}\n            onDragStart={(e) => handleDragStart(e, page.id)}\n            onDragOver={handleDragOver}\n            onDrop={(e) => handleDropOnPage(e, page.id)}\n            onContextMenu={(e) => handleContextMenu(e, page.id)}\n            onClick={() => {\n              onSelectPage(page.id);\n              if (onCloseMobile) onCloseMobile();\n            }}\n            style={{ paddingLeft: `${depth * 16 + 8}px` }}\n            className={`group py-2 pr-3 flex items-center justify-between cursor-pointer border-b border-[#1f1407]/60 transition-colors select-none ${\n              isActive\n                ? \'bg-[#3d2b17] text-[#FFFF55] border-l-4 border-l-[#FFD700] font-bold shadow-inner\'\n                : \'text-amber-100/80 hover:bg-[#382613] hover:text-white\'\n            }`}\n          >\n            <div className=\"flex items-center gap-2 overflow-hidden flex-1\">\n              {/* Collapse Arrow */}\n              {hasChildren ? (\n                <button\n                  onClick={(e) => toggleCollapse(page.id, e)}\n                  className=\"w-4 h-4 flex items-center justify-center text-xs text-amber-400/80 hover:text-white font-pixel\"\n                >\n                  {isCollapsed ? \'\342\226\266\' : \'\342\226\274\'}\n                </button>\n              ) : (\n                <span className=\"w-4 h-4\" />\n              )}\n\n              {/* Page Icon */}\n              <span className=\"text-base shrink-0\">{page.icon || \'\360\237\223\204\'}</span>\n\n              {/* Title / Edit input */}\n              {isEditing ? (\n                <input\n                  type=\"text\"\n                  value={editingTitle}\n                  onChange={(e) => setEditingTitle(e.target.value)}\n                  onBlur={() => handleSaveRename(page.id)}\n                  onKeyDown={(e) => handleKeyDownRename(e, page.id)}\n                  autoFocus\n                  onClick={(e) => e.stopPropagation()}\n                  className=\"bg-[#120b04] text-amber-200 border border-[#FFD700] px-1.5 py-0.5 text-xs font-pixel w-full focus:outline-none\"\n                />\n              ) : (\n                <span className=\"text-xs truncate font-pixel leading-tight\">\n                  {page.title}\n                </span>\n              )}\n            </div>\n\n            {/* Quick Actions Menu Trigger */}\n            <div className=\"hidden group-hover:flex items-center gap-1 shrink-0\">\n              <button\n                onClick={(e) => {\n                  e.stopPropagation();\n                  onCreatePage(page.id, \'Sub-Note\', \'\360\237\223\234\');\n                }}\n                className=\"text-xs text-amber-300 hover:text-white p-1\"\n                title=\"Add Sub-Page\"\n              >\n                \342\236\225\n              </button>\n              <button\n                onClick={(e) => handleContextMenu(e, page.id)}\n                className=\"text-xs text-amber-300 hover:text-white p-1\"\n                title=\"Options\"\n              >\n                \342\213\256\n              </button>\n            </div>\n          </div>\n\n          {/* Child Pages */}\n          {hasChildren && !isCollapsed && (\n            <div className=\"flex flex-col\">\n              {renderPageTree(children, depth + 1)}\n            </div>\n          )}\n        </div>\n      );\n    });\n  };\n\n  return (\n    <>\n      <aside\n        className={`mc-oak-wood-bg w-72 h-full flex flex-col shrink-0 relative z-20 transition-all duration-200 ${\n          isOpen ? \'translate-x-0\' : \'-translate-x-full md:translate-x-0 md:w-0 md:opacity-0 md:pointer-events-none\'\n        }`}\n      >\n        {/* Sidebar Header */}\n        <div className=\"p-4 border-b-2 border-[#120b04] flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"text-xl\">\360\237\223\232</span>\n            <h2 className=\"font-pixel text-sm text-[#FFD700] tracking-wider text-shadow\">\n              INVENTORY\n            </h2>\n          </div>\n          {onCloseMobile && (\n            <button\n              onClick={onCloseMobile}\n              className=\"md:hidden text-amber-200 font-pixel text-xs hover:text-white p-1\"\n            >\n              \342\234\225\n            </button>\n          )}\n        </div>\n\n        {/* Crafting Button: + NEW PAGE */}\n        <div className=\"p-3\">\n          <button\n            onClick={() => onCreatePage(null, \'New Craft Note\', \'\360\237\223\204\')}\n            className=\"w-full py-2.5 px-3 bg-[#1e2e1a] border-2 border-[#55FF55] hover:bg-[#273d22] text-[#55FF55] font-pixel text-xs flex items-center justify-center gap-2 cursor-pointer shadow-md hover:shadow-lg transition-all active:scale-98 animate-pulse\"\n          >\n            <span>\342\234\250</span>\n            <span>+ NEW PAGE</span>\n          </button>\n        </div>\n\n        {/* Search Bar */}\n        <div className=\"px-3 pb-2\">\n          <input\n            type=\"text\"\n            placeholder=\"Search items...\"\n            value={searchTerm}\n            onChange={(e) => setSearchTerm(e.target.value)}\n            className=\"w-full bg-[#171008] border border-[#3d2812] text-amber-100 font-pixel text-[10px] px-2.5 py-2 placeholder-amber-700 focus:outline-none focus:border-[#FFD700]\"\n          />\n        </div>\n\n        {/* Page Tree Container */}\n        <div\n          onDragOver={handleDragOver}\n          onDrop={handleDropOnRoot}\n          className=\"flex-1 overflow-y-auto custom-scrollbar\"\n        >\n          {searchTerm ? (\n            <div className=\"py-2\">\n              {filteredPages.map((page) => (\n                <div\n                  key={page.id}\n                  onClick={() => onSelectPage(page.id)}\n                  className={`px-3 py-2 text-xs font-pixel cursor-pointer flex items-center gap-2 ${\n                    page.id === activePageId\n                      ? \'bg-[#3d2b17] text-[#FFFF55]\'\n                      : \'text-amber-100/80 hover:bg-[#382613]\'\n                  }`}\n                >\n                  <span>{page.icon || \'\360\237\223\204\'}</span>\n                  <span className=\"truncate\">{page.title}</span>\n                </div>\n              ))}\n            </div>\n          ) : (\n            renderPageTree(rootPages, 0)\n          )}\n        </div>\n\n        {/* Sidebar Footer */}\n        <div className=\"p-3 border-t border-[#120b04] bg-[#1a1208] text-[10px] font-pixel text-amber-500/70 flex items-center justify-between\">\n          <span>ITEMS: {pages.length}</span>\n          <span>STORAGE: OK</span>\n        </div>\n      </aside>\n\n      {/* Context Menu Popup */}\n      {contextMenu && (\n        <div\n          className=\"fixed inset-0 z-50 bg-black/20\"\n          onClick={() => setContextMenu(null)}\n        >\n          <div\n            style={{ top: contextMenu.y, left: contextMenu.x }}\n            className=\"fixed mc-window-dark p-2 w-48 shadow-2xl font-pixel text-xs z-50 flex flex-col gap-1\"\n          >\n            <button\n              onClick={() => {\n                const target = pages.find((p) => p.id === contextMenu.id);\n                if (target) handleStartRename(target);\n              }}\n              className=\"text-left px-3 py-2 text-amber-200 hover:bg-[#3a5fcd] hover:text-white flex items-center gap-2\"\n            >\n              <span>\342\234\217\357\270\217</span>\n              <span>Rename</span>\n            </button>\n            <button\n              onClick={() => {\n                onCreatePage(contextMenu.id, \'Child Note\', \'\360\237\223\234\');\n                setContextMenu(null);\n              }}\n              className=\"text-left px-3 py-2 text-amber-200 hover:bg-[#3a5fcd] hover:text-white flex items-center gap-2\"\n            >\n              <span>\342\236\225</span>\n              <span>Add Child Page</span>\n            </button>\n            <button\n              onClick={() => {\n                onDuplicatePage(contextMenu.id);\n                setContextMenu(null);\n              }}\n              className=\"text-left px-3 py-2 text-amber-200 hover:bg-[#3a5fcd] hover:text-white flex items-center gap-2\"\n            >\n              <span>\360\237\223\213</span>\n              <span>Duplicate</span>\n            </button>\n            <div className=\"h-0.5 bg-[#3f3f5a] my-1\" />\n            <button\n              onClick={() => {\n                onDeletePage(contextMenu.id);\n                setContextMenu(null);\n              }}\n              className=\"text-left px-3 py-2 text-red-400 hover:bg-red-900/80 hover:text-white flex items-center gap-2\"\n            >\n              <span>\360\237\224\245</span>\n              <span>Drop in Lava</span>\n            </button>\n          </div>\n        </div>\n      )}\n    </>\n  );\n};\n"
    }
