  file_change {
    absolute_path_uri: "file:///src/components/GoogleDocsMenuBar.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useRef, useEffect } from \'react\';\nimport { Page, PageSettings, EditorMode, UserProfile } from \'../types/editor\';\n\ninterface GoogleDocsMenuBarProps {\n  activePage: Page | null;\n  mode: EditorMode;\n  pageSettings: PageSettings;\n  profile?: UserProfile;\n  isSidebarOpen: boolean;\n  onUpdateTitle: (title: string) => void;\n  onToggleStar?: () => void;\n  onNewPage: () => void;\n  onDuplicatePage: () => void;\n  onDeletePage: () => void;\n  onToggleSidebar: () => void;\n  onToggleMode: () => void;\n  onOpenPageSetup: () => void;\n  onOpenFindReplace: () => void;\n  onOpenWordCount: () => void;\n  onOpenSpecialCharacters: () => void;\n  onOpenSettings: () => void;\n  onFormat: (cmd: string, value?: string) => void;\n  onExport: (format: \'pdf\' | \'txt\' | \'md\' | \'html\' | \'json\') => void;\n  onZoomChange?: (zoom: number) => void;\n  onTriggerCreeper?: () => void;\n}\n\nexport const GoogleDocsMenuBar: React.FC<GoogleDocsMenuBarProps> = ({\n  activePage,\n  mode,\n  pageSettings,\n  profile,\n  isSidebarOpen,\n  onUpdateTitle,\n  onToggleStar,\n  onNewPage,\n  onDuplicatePage,\n  onDeletePage,\n  onToggleSidebar,\n  onToggleMode,\n  onOpenPageSetup,\n  onOpenFindReplace,\n  onOpenWordCount,\n  onOpenSpecialCharacters,\n  onOpenSettings,\n  onFormat,\n  onExport,\n  onZoomChange,\n  onTriggerCreeper,\n}) => {\n  const [activeMenu, setActiveMenu] = useState<string | null>(null);\n  const menuBarRef = useRef<HTMLDivElement>(null);\n\n  // Close menus when clicking outside\n  useEffect(() => {\n    const handleClickOutside = (e: MouseEvent) => {\n      if (menuBarRef.current && !menuBarRef.current.contains(e.target as Node)) {\n        setActiveMenu(null);\n      }\n    };\n    document.addEventListener(\'mousedown\', handleClickOutside);\n    return () => document.removeEventListener(\'mousedown\', handleClickOutside);\n  }, []);\n\n  const handleMenuClick = (menu: string) => {\n    setActiveMenu((prev) => (prev === menu ? null : menu));\n  };\n\n  const handleItemClick = (action: () => void) => {\n    action();\n    setActiveMenu(null);\n  };\n\n  return (\n    <div\n      ref={menuBarRef}\n      className=\"mc-stone-bg w-full px-3 py-1.5 flex flex-col border-b-2 border-[#111] z-40 select-none no-print\"\n    >\n      {/* Top Row: Logo, Editable Title, Star, Cloud Sync, Mode Switcher, Profile */}\n      <div className=\"flex items-center justify-between gap-3 flex-wrap\">\n        <div className=\"flex items-center gap-2.5\">\n          {/* Logo & Icon */}\n          <button\n            onClick={onToggleSidebar}\n            className=\"mc-slot flex items-center justify-center text-lg shrink-0 cursor-pointer\"\n            title={isSidebarOpen ? \'Close Inventory Sidebar\' : \'Open Inventory Sidebar\'}\n          >\n            <span>{activePage?.icon || \'\360\237\223\234\'}</span>\n          </button>\n\n          {/* Document Title & Badge */}\n          <div className=\"flex flex-col\">\n            <div className=\"flex items-center gap-2\">\n              <input\n                type=\"text\"\n                value={activePage?.title || \'\'}\n                onChange={(e) => onUpdateTitle(e.target.value)}\n                placeholder=\"Untitled document\"\n                className=\"bg-transparent text-white font-pixel text-xs md:text-sm font-bold hover:bg-black/30 px-1.5 py-0.5 rounded border border-transparent hover:border-[#555] focus:border-[#FFD700] focus:bg-black/50 focus:outline-none max-w-[200px] sm:max-w-xs md:max-w-md truncate\"\n              />\n              \n              {/* Star Button */}\n              <button\n                onClick={onToggleStar}\n                className=\"text-sm text-yellow-400 hover:scale-110 transition-transform cursor-pointer\"\n                title={activePage?.isStarred ? \'Unstar document\' : \'Star document\'}\n              >\n                {activePage?.isStarred ? \'\342\255\220\' : \'\342\230\206\'}\n              </button>\n\n              {/* Cloud Saved Indicator */}\n              <div\n                className=\"flex items-center gap-1 text-[9px] font-pixel text-gray-400\"\n                title=\"All changes saved in local world storage\"\n              >\n                <span className=\"text-green-400\">\342\230\201\357\270\217</span>\n                <span className=\"hidden lg:inline text-gray-300\">Saved</span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Right Quick Controls: Mode Badge, Page Setup, Settings */}\n        <div className=\"flex items-center gap-2 ml-auto\">\n          {/* Mode Switcher Pill */}\n          <button\n            onClick={onToggleMode}\n            className={`mc-button px-2.5 py-1 text-xs font-pixel flex items-center gap-1.5 ${\n              mode === \'creative\'\n                ? \'bg-amber-900 border-amber-500 text-amber-200\'\n                : \'bg-stone-800 border-stone-500 text-green-300\'\n            }`}\n            title=\"Switch between Survival (Google Docs) and Creative (Notion Blocks) modes\"\n          >\n            <span>{mode === \'creative\' ? \'\360\237\247\261 CREATIVE\' : \'\342\232\224\357\270\217 SURVIVAL\'}</span>\n          </button>\n\n          {/* Quick Page Setup Button */}\n          <button\n            onClick={onOpenPageSetup}\n            className=\"mc-button px-2 py-1 text-xs font-pixel text-yellow-300 flex items-center gap-1\"\n            title=\"Configure Page Size (A4 Default, Letter, Legal, Book, Pageless) and Margins\"\n          >\n            <span>\360\237\223\204</span>\n            <span className=\"hidden sm:inline uppercase text-[10px]\">\n              {pageSettings.pageSize.toUpperCase()} ({pageSettings.pageColor})\n            </span>\n          </button>\n\n          {/* Settings Button */}\n          <button\n            onClick={onOpenSettings}\n            className=\"mc-button px-2 py-1 text-xs font-pixel text-gray-300 hover:text-white flex items-center gap-1\"\n            title=\"Document & Profile Settings\"\n          >\n            <span>\342\232\231\357\270\217</span>\n            <span className=\"hidden sm:inline text-[10px]\">SETTINGS</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Bottom Row: Google Docs Standard Dropdown Menus (File, Edit, View, Insert, Format, Tools, Help) */}\n      <div className=\"flex items-center gap-1 mt-1 text-xs font-sans text-gray-200 relative flex-wrap\">\n        {/* FILE MENU */}\n        <div className=\"relative\">\n          <button\n            onClick={() => handleMenuClick(\'file\')}\n            className={`px-2 py-0.5 rounded text-xs hover:bg-[#555] cursor-pointer ${\n              activeMenu === \'file\' ? \'bg-[#555] text-white font-bold\' : \'\'\n            }`}\n          >\n            File\n          </button>\n          {activeMenu === \'file\' && (\n            <div className=\"absolute top-full left-0 mt-1 w-56 bg-[#2d2d2d] border-2 border-[#555] shadow-2xl py-1 z-50 text-gray-100 font-sans text-xs flex flex-col\">\n              <button\n                onClick={() => handleItemClick(onNewPage)}\n                className=\"px-3 py-1.5 text-left hover:bg-[#444] flex items-center justify-between\"\n              >\n                <span>\360\237\223\204 New document</span>\n                <span className=\"text-[10px] text-gray-400\">Ctrl+N</span>\n              </button>\n              <button\n                onClick={() => handleItemClick(onDuplicatePage)}\n                className=\"px-3 py-1.5 text-left hover:bg-[#444] flex items-center justify-between\"\n              >\n                <span>\360\237\223\213 Make a copy</span>\n              </button>\n              <div className=\"border-t border-[#444] my-1\" />\n              \n              {/* Export Submenu Options */}\n              <div className=\"px-3 py-1 text-[10px] font-pixel text-yellow-400 uppercase\">\n                Download / Export:\n              </div>\n              <button\n                onClick={() => handleItemClick(() => onExport(\'pdf\'))}\n                className=\"px-3 py-1.5 text-left hover:bg-[#444] flex items-center justify-between\"\n              >\n                <span>\360\237\223\221 PDF Document (.pdf / Print)</span>\n              </button>\n              <button\n                onClick={() => handleItemClick(() => onExport(\'txt\'))}\n                className=\"px-3 py-1.5 text-left hover:bg-[#444] flex items-center justify-between\"\n              >\n                <span>\360\237\223\235 Plain Text (.txt)</span>\n              </button>\n              <button\n                onClick={() => handleItemClick(() => onExport(\'md\'))}\n                className=\"px-3 py-1.5 text-left hover:bg-[#444] flex items-center justify-between\"\n              >\n                <span>\360\237\247\261 Markdown (.md)</span>\n              </button>\n              <button\n                onClick={() => handleItemClick(() => onExport(\'html\'))}\n                className=\"px-3 py-1.5 text-left hover:bg-[#444] flex items-center justify-between\"\n              >\n                <span>\360\237\214\220 Web Page (.html)</span>\n              </button>\n              <button\n                onClick={() => handleItemClick(() => onExport(\'json\'))}\n                className=\"px-3 py-1.5 text-left hover:bg-[#444] flex items-center justify-between\"\n              >\n                <span>\360\237\222\276 JSON Backup (.json)</span>\n              </button>\n\n              <div className=\"border-t border-[#444] my-1\" />\n              <button\n                onClick={() => handleItemClick(onOpenPageSetup)}\n                className=\"px-3 py-1.5 text-left hover:bg-[#444] flex items-center justify-between text-yellow-300 font-semibold\"\n              >\n                <span>\360\237\223\204 Page setup...</span>\n                <span className=\"text-[10px] text-gray-400\">A4 Default</span>\n              </button>\n              <button\n                onClick={() => handleItemClick(() => window.print())}\n                className=\"px-3 py-1.5 text-left hover:bg-[#444] flex items-center justify-between\"\n              >\n                <span>\360\237\226\250\357\270\217 Print</span>\n                <span className=\"text-[10px] text-gray-400\">Ctrl+P</span>\n              </button>\n              <div className=\"border-t border-[#444] my-1\" />\n              <button\n                onClick={() => handleItemClick(onDeletePage)}\n                className=\"px-3 py-1.5 text-left hover:bg-red-900/80 text-red-300 flex items-center justify-between\"\n              >\n                <span>\360\237\224\245 Move to trash</span>\n              </button>\n            </div>\n          )}\n        </div>\n\n        {/* EDIT MENU */}\n        <div className=\"relative\">\n          <button\n            onClick={() => handleMenuClick(\'edit\')}\n            className={`px-2 py-0.5 rounded text-xs hover:bg-[#555] cursor-pointer ${\n              activeMenu === \'edit\' ? \'bg-[#555] text-white font-bold\' : \'\'\n            }`}\n          >\n            Edit\n          </button>\n          {activeMenu === \'edit\' && (\n            <div className=\"absolute top-full left-0 mt-1 w-52 bg-[#2d2d2d] border-2 border-[#555] shadow-2xl py-1 z-50 text-gray-100 font-sans text-xs flex flex-col\">\n              <button\n                onClick={() => handleItemClick(() => onFormat(\'undo\'))}\n                className=\"px-3 py-1.5 text-left hover:bg-[#444] flex items-center justify-between\"\n              >\n                <span>\342\206\251\357\270\217 Undo</span>\n                <span className=\"text-[10px] text-gray-400\">Ctrl+Z</span>\n              </button>\n              <button\n                onClick={() => handleItemClick(() => onFormat(\'redo\'))}\n                className=\"px-3 py-1.5 text-left hover:bg-[#444] flex items-center justify-between\"\n              >\n                <span>\342\206\252\357\270\217 Redo</span>\n                <span className=\"text-[10px] text-gray-400\">Ctrl+Y</span>\n              </button>\n              <div className=\"border-t border-[#444] my-1\" />\n              <button\n                onClick={() => handleItemClick(() => onFormat(\'selectAll\'))}\n                className=\"px-3 py-1.5 text-left hover:bg-[#444] flex items-center justify-between\"\n              >\n                <span>Select all</span>\n                <span className=\"text-[10px] text-gray-400\">Ctrl+A</span>\n              </button>\n              <button\n                onClick={() => handleItemClick(onOpenFindReplace)}\n                className=\"px-3 py-1.5 text-left hover:bg-[#444] flex items-center justify-between text-yellow-300\"\n              >\n                <span>\360\237\224\215 Find and replace</span>\n                <span className=\"text-[10px] text-gray-400\">Ctrl+H</span>\n              </button>\n              <div className=\"border-t border-[#444] my-1\" />\n              <button\n                onClick={() => handleItemClick(() => onFormat(\'removeFormat\'))}\n                className=\"px-3 py-1.5 text-left hover:bg-[#444] flex items-center justify-between\"\n              >\n                <span>\360\237\247\271 Clear formatting</span>\n                <span className=\"text-[10px] text-gray-400\">Ctrl+\\</span>\n              </button>\n            </div>\n          )}\n        </div>\n\n        {/* VIEW MENU */}\n        <div className=\"relative\">\n          <button\n            onClick={() => handleMenuClick(\'view\')}\n            className={`px-2 py-0.5 rounded text-xs hover:bg-[#555] cursor-pointer ${\n              activeMenu === \'view\' ? \'bg-[#555] text-white font-bold\' : \'\'\n            }`}\n          >\n            View\n          </button>\n          {activeMenu === \'view\' && (\n            <div className=\"absolute top-full left-0 mt-1 w-52 bg-[#2d2d2d] border-2 border-[#555] shadow-2xl py-1 z-50 text-gray-100 font-sans text-xs flex flex-col\">\n              <button\n                onClick={() => handleItemClick(onToggleMode)}\n                className=\"px-3 py-1.5 text-left hover:bg-[#444] flex items-center justify-between\"\n              >\n                <span>Mode: {mode === \'survival\' ? \'\342\232\224\357\270\217 Survival\' : \'\360\237\247\261 Creative\'}</span>\n              </button>\n              <button\n                onClick={() => handleItemClick(onToggleSidebar)}\n                className=\"px-3 py-1.5 text-left hover:bg-[#444] flex items-center justify-between\"\n              >\n                <span>\360\237\216\222 Show Inventory Sidebar</span>\n                <span className=\"text-xs\">{isSidebarOpen ? \'\342\234\223\' : \'\'}</span>\n              </button>\n              <div className=\"border-t border-[#444] my-1\" />\n              <div className=\"px-3 py-1 text-[10px] font-pixel text-yellow-400\">Zoom:</div>\n              {[75, 90, 100, 125, 150].map((z) => (\n                <button\n                  key={z}\n                  onClick={() => handleItemClick(() => onZoomChange && onZoomChange(z))}\n                  className=\"px-4 py-1 text-left hover:bg-[#444] flex items-center justify-between\"\n                >\n                  <span>{z}%</span>\n                  {pageSettings.zoomLevel === z && <span className=\"text-xs\">\342\234\223</span>}\n                </button>\n              ))}\n            </div>\n          )}\n        </div>\n\n        {/* INSERT MENU */}\n        <div className=\"relative\">\n          <button\n            onClick={() => handleMenuClick(\'insert\')}\n            className={`px-2 py-0.5 rounded text-xs hover:bg-[#555] cursor-pointer ${\n              activeMenu === \'insert\' ? \'bg-[#555] text-white font-bold\' : \'\'\n            }`}\n          >\n            Insert\n          </button>\n          {activeMenu === \'insert\' && (\n            <div className=\"absolute top-full left-0 mt-1 w-56 bg-[#2d2d2d] border-2 border-[#555] shadow-2xl py-1 z-50 text-gray-100 font-sans text-xs flex flex-col\">\n              <button\n                onClick={() => {\n                  const url = prompt(\n                    \'Enter image or Minecraft texture URL:\',\n                    \'https://images.unsplash.com/photo-1627856013091-fed6e4e30025?w=800&auto=format&fit=crop&q=80\'\n                  );\n                  if (url) handleItemClick(() => onFormat(\'insertImage\', url));\n                }}\n                className=\"px-3 py-1.5 text-left hover:bg-[#444] flex items-center gap-2\"\n              >\n                <span>\360\237\227\272\357\270\217 Image</span>\n              </button>\n              <button\n                onClick={() =>\n                  handleItemClick(() => {\n                    const tableHtml = `\n                      <table style=\"width:100%; border-collapse:collapse; margin:12px 0; border:2px solid #555;\">\n                        <tbody>\n                          <tr>\n                            <th style=\"border:1px solid #777; padding:8px; background:#e2e8f0; color:#111;\">Item / Slot</th>\n                            <th style=\"border:1px solid #777; padding:8px; background:#e2e8f0; color:#111;\">Quantity</th>\n                            <th style=\"border:1px solid #777; padding:8px; background:#e2e8f0; color:#111;\">Enchantment</th>\n                          </tr>\n                          <tr>\n                            <td style=\"border:1px solid #777; padding:8px; color:#111;\">Diamond Sword \342\232\224\357\270\217</td>\n                            <td style=\"border:1px solid #777; padding:8px; color:#111;\">1</td>\n                            <td style=\"border:1px solid #777; padding:8px; color:#111;\">Sharpness V</td>\n                          </tr>\n                        </tbody>\n                      </table>\n                    `;\n                    onFormat(\'insertHTML\', tableHtml);\n                  })\n                }\n                className=\"px-3 py-1.5 text-left hover:bg-[#444] flex items-center gap-2\"\n              >\n                <span>\360\237\247\261 Table (Crafting Grid)</span>\n              </button>\n              <button\n                onClick={() => handleItemClick(() => onFormat(\'insertHorizontalRule\'))}\n                className=\"px-3 py-1.5 text-left hover:bg-[#444] flex items-center gap-2\"\n              >\n                <span>\342\236\226 Horizontal line</span>\n              </button>\n              <button\n                onClick={() => handleItemClick(onOpenSpecialCharacters)}\n                className=\"px-3 py-1.5 text-left hover:bg-[#444] flex items-center gap-2 text-yellow-300\"\n              >\n                <span>\342\234\250 Special characters & glyphs...</span>\n              </button>\n              <div className=\"border-t border-[#444] my-1\" />\n              <button\n                onClick={() => {\n                  const url = prompt(\'Enter URL for link:\', \'https://\');\n                  if (url) handleItemClick(() => onFormat(\'createLink\', url));\n                }}\n                className=\"px-3 py-1.5 text-left hover:bg-[#444] flex items-center justify-between\"\n              >\n                <span>\360\237\222\216 Link</span>\n                <span className=\"text-[10px] text-gray-400\">Ctrl+K</span>\n              </button>\n              <button\n                onClick={() =>\n                  handleItemClick(() =>\n                    onFormat(\'insertText\', ` [${new Date().toLocaleDateString()}] `)\n                  )\n                }\n                className=\"px-3 py-1.5 text-left hover:bg-[#444] flex items-center gap-2\"\n              >\n                <span>\360\237\223\205 Date stamp</span>\n              </button>\n            </div>\n          )}\n        </div>\n\n        {/* FORMAT MENU */}\n        <div className=\"relative\">\n          <button\n            onClick={() => handleMenuClick(\'format\')}\n            className={`px-2 py-0.5 rounded text-xs hover:bg-[#555] cursor-pointer ${\n              activeMenu === \'format\' ? \'bg-[#555] text-white font-bold\' : \'\'\n            }`}\n          >\n            Format\n          </button>\n          {activeMenu === \'format\' && (\n            <div className=\"absolute top-full left-0 mt-1 w-56 bg-[#2d2d2d] border-2 border-[#555] shadow-2xl py-1 z-50 text-gray-100 font-sans text-xs flex flex-col\">\n              <div className=\"px-3 py-1 text-[10px] font-pixel text-yellow-400\">Text:</div>\n              <button\n                onClick={() => handleItemClick(() => onFormat(\'bold\'))}\n                className=\"px-3 py-1 text-left hover:bg-[#444] flex items-center justify-between font-bold\"\n              >\n                <span>Bold</span>\n                <span className=\"text-[10px] text-gray-400\">Ctrl+B</span>\n              </button>\n              <button\n                onClick={() => handleItemClick(() => onFormat(\'italic\'))}\n                className=\"px-3 py-1 text-left hover:bg-[#444] flex items-center justify-between italic\"\n              >\n                <span>Italic</span>\n                <span className=\"text-[10px] text-gray-400\">Ctrl+I</span>\n              </button>\n              <button\n                onClick={() => handleItemClick(() => onFormat(\'underline\'))}\n                className=\"px-3 py-1 text-left hover:bg-[#444] flex items-center justify-between underline\"\n              >\n                <span>Underline</span>\n                <span className=\"text-[10px] text-gray-400\">Ctrl+U</span>\n              </button>\n              <button\n                onClick={() => handleItemClick(() => onFormat(\'strikeThrough\'))}\n                className=\"px-3 py-1 text-left hover:bg-[#444] flex items-center justify-between line-through\"\n              >\n                <span>Strikethrough</span>\n              </button>\n              <div className=\"border-t border-[#444] my-1\" />\n              <div className=\"px-3 py-1 text-[10px] font-pixel text-yellow-400\">Paragraph Styles:</div>\n              <button\n                onClick={() => handleItemClick(() => onFormat(\'formatBlock\', \'<p>\'))}\n                className=\"px-3 py-1 text-left hover:bg-[#444]\"\n              >\n                Normal text\n              </button>\n              <button\n                onClick={() => handleItemClick(() => onFormat(\'formatBlock\', \'<h1>\'))}\n                className=\"px-3 py-1 text-left hover:bg-[#444] font-bold text-sm\"\n              >\n                Heading 1\n              </button>\n              <button\n                onClick={() => handleItemClick(() => onFormat(\'formatBlock\', \'<h2>\'))}\n                className=\"px-3 py-1 text-left hover:bg-[#444] font-bold text-xs\"\n              >\n                Heading 2\n              </button>\n              <button\n                onClick={() => handleItemClick(() => onFormat(\'formatBlock\', \'<h3>\'))}\n                className=\"px-3 py-1 text-left hover:bg-[#444] font-bold text-xs\"\n              >\n                Heading 3\n              </button>\n              <div className=\"border-t border-[#444] my-1\" />\n              <button\n                onClick={() => handleItemClick(onOpenPageSetup)}\n                className=\"px-3 py-1.5 text-left hover:bg-[#444] text-yellow-300 font-semibold flex items-center justify-between\"\n              >\n                <span>\360\237\223\204 Page setup...</span>\n                <span className=\"text-[10px] text-gray-400\">A4 Default</span>\n              </button>\n            </div>\n          )}\n        </div>\n\n        {/* TOOLS MENU */}\n        <div className=\"relative\">\n          <button\n            onClick={() => handleMenuClick(\'tools\')}\n            className={`px-2 py-0.5 rounded text-xs hover:bg-[#555] cursor-pointer ${\n              activeMenu === \'tools\' ? \'bg-[#555] text-white font-bold\' : \'\'\n            }`}\n          >\n            Tools\n          </button>\n          {activeMenu === \'tools\' && (\n            <div className=\"absolute top-full left-0 mt-1 w-52 bg-[#2d2d2d] border-2 border-[#555] shadow-2xl py-1 z-50 text-gray-100 font-sans text-xs flex flex-col\">\n              <button\n                onClick={() => handleItemClick(onOpenWordCount)}\n                className=\"px-3 py-1.5 text-left hover:bg-[#444] flex items-center justify-between text-yellow-300 font-semibold\"\n              >\n                <span>\360\237\223\212 Word count</span>\n                <span className=\"text-[10px] text-gray-400\">Ctrl+Shift+C</span>\n              </button>\n              <button\n                onClick={() => handleItemClick(onOpenFindReplace)}\n                className=\"px-3 py-1.5 text-left hover:bg-[#444] flex items-center justify-between\"\n              >\n                <span>\360\237\224\215 Find and replace</span>\n                <span className=\"text-[10px] text-gray-400\">Ctrl+H</span>\n              </button>\n              <div className=\"border-t border-[#444] my-1\" />\n              {onTriggerCreeper && (\n                <button\n                  onClick={() => handleItemClick(onTriggerCreeper)}\n                  className=\"px-3 py-1.5 text-left hover:bg-red-900/80 text-red-300 flex items-center gap-2 font-pixel text-[10px]\"\n                >\n                  <span>\360\237\222\245 Detonate Page (Creeper)</span>\n                </button>\n              )}\n            </div>\n          )}\n        </div>\n\n        {/* HELP MENU */}\n        <div className=\"relative\">\n          <button\n            onClick={() => handleMenuClick(\'help\')}\n            className={`px-2 py-0.5 rounded text-xs hover:bg-[#555] cursor-pointer ${\n              activeMenu === \'help\' ? \'bg-[#555] text-white font-bold\' : \'\'\n            }`}\n          >\n            Help\n          </button>\n          {activeMenu === \'help\' && (\n            <div className=\"absolute top-full left-0 mt-1 w-52 bg-[#2d2d2d] border-2 border-[#555] shadow-2xl py-1 z-50 text-gray-100 font-sans text-xs flex flex-col\">\n              <button\n                onClick={() => handleItemClick(onOpenSettings)}\n                className=\"px-3 py-1.5 text-left hover:bg-[#444] flex items-center gap-2\"\n              >\n                <span>\342\214\250\357\270\217 Keyboard shortcuts</span>\n              </button>\n              <button\n                onClick={() => handleItemClick(onOpenSettings)}\n                className=\"px-3 py-1.5 text-left hover:bg-[#444] flex items-center gap-2\"\n              >\n                <span>\360\237\221\244 Character skin & theme</span>\n              </button>\n              <div className=\"border-t border-[#444] my-1\" />\n              <div className=\"px-3 py-1.5 text-[10px] text-gray-400 font-pixel\">\n                CraftDocs v2.0 (Google Docs Edition)\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
