    replacement_chunks {
      replacement_content: "import React, { useRef, useEffect } from \'react\';\nimport { Page } from \'../types/editor\';\n\ninterface SurvivalEditorProps {\n  activePage: Page | null;\n  activePageHtml: string;\n  onUpdateHtml: (html: string) => void;\n  onUpdateTitle: (title: string) => void;\n  editorRef: React.RefObject<HTMLDivElement | null>;\n}\n\nexport const SurvivalEditor: React.FC<SurvivalEditorProps> = ({\n  activePage,\n  activePageHtml,\n  onUpdateHtml,\n  onUpdateTitle,\n  editorRef,\n}) => {\n  const isUpdatingRef = useRef(false);\n\n  // Sync incoming HTML without resetting cursor unless changed externally\n  useEffect(() => {\n    if (editorRef.current && !isUpdatingRef.current) {\n      if (editorRef.current.innerHTML !== activePageHtml) {\n        editorRef.current.innerHTML = activePageHtml;\n      }\n    }\n  }, [activePageHtml, editorRef]);\n\n  if (!activePage) {\n    return (\n      <div className=\"flex-1 flex items-center justify-center p-8 text-center font-pixel text-amber-300\">\n        \342\232\224\357\270\217 Select or craft a page from your inventory.\n      </div>\n    );\n  }\n\n  const handleInput = () => {\n    if (!editorRef.current) return;\n    isUpdatingRef.current = true;\n    const html = editorRef.current.innerHTML;\n    onUpdateHtml(html);\n    setTimeout(() => {\n      isUpdatingRef.current = false;\n    }, 50);\n  };\n\n  return (\n    <div className=\"flex-1 overflow-y-auto p-4 md:p-10 flex justify-center custom-scrollbar\">\n      {/* Parchment Document Sheet Container */}\n      <div className=\"mc-parchment-bg w-full max-w-4xl min-h-[85vh] p-6 md:p-12 shadow-2xl relative transition-all\">\n        {/* Document Header */}\n        <div className=\"mb-6 border-b-2 border-[#8B6914] pb-4 flex items-center gap-3\">\n          <span className=\"text-3xl\">{activePage.icon || \'\360\237\223\234\'}</span>\n          <input\n            type=\"text\"\n            value={activePage.title}\n            onChange={(e) => onUpdateTitle(e.target.value)}\n            placeholder=\"Untitled Craft Note...\"\n            className=\"w-full bg-transparent font-pixel text-lg md:text-xl text-[#2c2211] focus:outline-none placeholder-[#8B6914]/50\"\n          />\n        </div>\n\n        {/* Continuous Contenteditable Editor Area */}\n        <div\n          ref={editorRef}\n          contentEditable\n          suppressContentEditableWarning\n          onInput={handleInput}\n          className=\"font-doc text-base md:text-lg text-[#2c2211] leading-relaxed outline-none min-h-[550px] mc-caret\"\n        />\n\n        {/* Bottom Helper Hint */}\n        <div className=\"mt-12 pt-4 border-t border-dashed border-[#8B6914]/40 font-pixel text-[10px] text-[#8B6914] flex items-center justify-between\">\n          <span>\342\232\224\357\270\217 SURVIVAL MODE ACTIVE</span>\n          <span>WYSIWYG CONTINUOUS FLOW</span>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
