  file_change {
    absolute_path_uri: "file:///src/components/GoogleDocsMenuBar.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "interface GoogleDocsMenuBarProps {\n  activePage: Page | null;\n  mode: EditorMode;\n  pageSettings: PageSettings;\n  profile?: UserProfile;\n  isSidebarOpen: boolean;\n  onUpdateTitle: (title: string) => void;\n  onToggleStar?: () => void;\n  onNewPage: () => void;\n  onDuplicatePage: () => void;\n  onDeletePage: () => void;\n  onToggleSidebar: () => void;\n  onToggleMode: () => void;\n  onOpenPageSetup: () => void;\n  onOpenFindReplace: () => void;\n  onOpenWordCount: () => void;\n  onOpenSpecialCharacters: () => void;\n  onOpenSettings: () => void;\n  onFormat: (cmd: string, value?: string) => void;\n  onExport: (format: \'pdf\' | \'txt\' | \'md\' | \'html\' | \'json\') => void;\n  onZoomChange?: (zoom: number) => void;\n  onTriggerCreeper?: () => void;\n}\n\nexport const GoogleDocsMenuBar: React.FC<GoogleDocsMenuBarProps> = ({\n  activePage,\n  mode,\n  pageSettings,\n  profile,\n  isSidebarOpen,\n  onUpdateTitle,\n  onToggleStar,\n  onNewPage,\n  onDuplicatePage,\n  onDeletePage,\n  onToggleSidebar,\n  onToggleMode,\n  onOpenPageSetup,\n  onOpenFindReplace,\n  onOpenWordCount,\n  onOpenSpecialCharacters,\n  onOpenSettings,\n  onFormat,\n  onExport,\n  onZoomChange,\n  onTriggerCreeper,\n}) => {\n  const [activeMenu, setActiveMenu] = useState<string | null>(null);\n  const menuBarRef = useRef<HTMLDivElement>(null);\n\n  // Close menus when clicking outside\n  useEffect(() => {\n    const handleClickOutside = (e: MouseEvent) => {\n      if (menuBarRef.current && !menuBarRef.current.contains(e.target as Node)) {\n        setActiveMenu(null);\n      }\n    };\n    document.addEventListener(\'mousedown\', handleClickOutside);\n    return () => document.removeEventListener(\'mousedown\', handleClickOutside);\n  }, []);\n\n  const handleMenuClick = (menu: string) => {\n    setActiveMenu((prev) => (prev === menu ? null : menu));\n  };\n\n  const handleItemClick = (action: () => void) => {\n    action();\n    setActiveMenu(null);\n  };\n\n  return (\n    <div\n      ref={menuBarRef}\n      className=\"mc-stone-bg w-full px-3 py-1.5 flex flex-col border-b-2 border-[#111] z-40 select-none no-print\"\n    >\n      {/* Top Row: Logo, Editable Title, Star, Cloud Sync, Mode Switcher, Profile */}\n      <div className=\"flex items-center justify-between gap-3 flex-wrap\">\n        <div className=\"flex items-center gap-2.5\">\n          {/* Logo & Icon */}\n          <button\n            onClick={onToggleSidebar}\n            className=\"mc-slot flex items-center justify-center text-lg shrink-0 cursor-pointer\"\n            title={isSidebarOpen ? \'Close Inventory Sidebar\' : \'Open Inventory Sidebar\'}\n          >\n            <span>{activePage?.icon || \'\360\237\223\234\'}</span>\n          </button>\n\n          {/* Document Title & Badge */}\n          <div className=\"flex flex-col\">\n            <div className=\"flex items-center gap-2\">\n              <input\n                type=\"text\"\n                value={activePage?.title || \'\'}\n                onChange={(e) => onUpdateTitle(e.target.value)}\n                placeholder=\"Untitled document\"\n                className=\"bg-transparent text-white font-pixel text-xs md:text-sm font-bold hover:bg-black/30 px-1.5 py-0.5 rounded border border-transparent hover:border-[#555] focus:border-[#FFD700] focus:bg-black/50 focus:outline-none max-w-[200px] sm:max-w-xs md:max-w-md truncate\"\n              />\n              \n              {/* Star Button */}\n              <button\n                onClick={onToggleStar}\n                className=\"text-sm text-yellow-400 hover:scale-110 transition-transform cursor-pointer\"\n                title={activePage?.isStarred ? \'Unstar document\' : \'Star document\'}\n              >\n                {activePage?.isStarred ? \'\342\255\220\' : \'\342\230\206\'}\n              </button>\n\n              {/* Cloud Saved Indicator */}\n              <div\n                className=\"flex items-center gap-1 text-[9px] font-pixel text-gray-400\"\n                title=\"All changes saved in local world storage\"\n              >\n                <span className=\"text-green-400\">\342\230\201\357\270\217</span>\n                <span className=\"hidden lg:inline text-gray-300\">Saved</span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Right Quick Controls: Mode Badge, Page Setup, Settings */}\n        <div className=\"flex items-center gap-2 ml-auto\">\n          {/* Mode Switcher Pill */}\n          <button\n            onClick={onToggleMode}\n            className={`mc-button px-2.5 py-1 text-xs font-pixel flex items-center gap-1.5 ${\n              mode === \'creative\'\n                ? \'bg-amber-900 border-amber-500 text-amber-200\'\n                : \'bg-stone-800 border-stone-500 text-green-300\'\n            }`}\n            title=\"Switch between Survival (Google Docs) and Creative (Notion Blocks) modes\"\n          >\n            <span>{mode === \'creative\' ? \'\360\237\247\261 CREATIVE\' : \'\342\232\224\357\270\217 SURVIVAL\'}</span>\n          </button>\n\n          {/* Quick Page Setup Button */}\n          <button\n            onClick={onOpenPageSetup}\n            className=\"mc-button px-2 py-1 text-xs font-pixel text-yellow-300 flex items-center gap-1\"\n            title=\"Configure Page Size (A4 Default, Letter, Legal, Book, Pageless) and Margins\"\n          >\n            <span>\360\237\223\204</span>\n            <span className=\"hidden sm:inline uppercase text-[10px]\">\n              {pageSettings.pageSize.toUpperCase()} ({pageSettings.pageColor})\n            </span>\n          </button>\n\n          {/* Settings Button */}\n          <button\n            onClick={onOpenSettings}\n            className=\"mc-button px-2 py-1 text-xs font-pixel text-gray-300 hover:text-white flex items-center gap-1\"\n            title=\"Document & Profile Settings\"\n          >\n            <span>\342\232\231\357\270\217</span>\n            <span className=\"hidden sm:inline text-[10px]\">SETTINGS</span>\n          </button>\n        </div>\n      </div>"
      replacement_content: "import React, { useState, useRef, useEffect } from \'react\';\nimport { Page, PageSettings, EditorMode, UserProfile } from \'../types/editor\';\nimport {\n  Home,\n  Cloud,\n  Share2,\n  Sparkles,\n  Settings,\n  Star,\n  Plus,\n  Copy,\n  Printer,\n  FileText,\n  Search,\n  Check,\n  Zap,\n} from \'lucide-react\';\n\ninterface GoogleDocsMenuBarProps {\n  activePage: Page | null;\n  mode: EditorMode;\n  pageSettings: PageSettings;\n  profile?: UserProfile;\n  isSidebarOpen: boolean;\n  onGoHome?: () => void;\n  onUpdateTitle: (title: string) => void;\n  onToggleStar?: () => void;\n  onNewPage: () => void;\n  onDuplicatePage: () => void;\n  onDeletePage: () => void;\n  onToggleSidebar: () => void;\n  onToggleMode: () => void;\n  onOpenPageSetup: () => void;\n  onOpenFindReplace: () => void;\n  onOpenWordCount: () => void;\n  onOpenSpecialCharacters: () => void;\n  onOpenSettings: () => void;\n  onOpenShareModal?: () => void;\n  onOpenGeminiModal?: () => void;\n  onOpenGoogleDriveModal?: () => void;\n  onFormat: (cmd: string, value?: string) => void;\n  onExport: (format: \'pdf\' | \'txt\' | \'md\' | \'html\' | \'json\') => void;\n  onZoomChange?: (zoom: number) => void;\n  onTriggerCreeper?: () => void;\n}\n\nexport const GoogleDocsMenuBar: React.FC<GoogleDocsMenuBarProps> = ({\n  activePage,\n  mode,\n  pageSettings,\n  profile,\n  isSidebarOpen,\n  onGoHome,\n  onUpdateTitle,\n  onToggleStar,\n  onNewPage,\n  onDuplicatePage,\n  onDeletePage,\n  onToggleSidebar,\n  onToggleMode,\n  onOpenPageSetup,\n  onOpenFindReplace,\n  onOpenWordCount,\n  onOpenSpecialCharacters,\n  onOpenSettings,\n  onOpenShareModal,\n  onOpenGeminiModal,\n  onOpenGoogleDriveModal,\n  onFormat,\n  onExport,\n  onZoomChange,\n  onTriggerCreeper,\n}) => {\n  const [activeMenu, setActiveMenu] = useState<string | null>(null);\n  const menuBarRef = useRef<HTMLDivElement>(null);\n\n  // Close menus when clicking outside\n  useEffect(() => {\n    const handleClickOutside = (e: MouseEvent) => {\n      if (menuBarRef.current && !menuBarRef.current.contains(e.target as Node)) {\n        setActiveMenu(null);\n      }\n    };\n    document.addEventListener(\'mousedown\', handleClickOutside);\n    return () => document.removeEventListener(\'mousedown\', handleClickOutside);\n  }, []);\n\n  const handleMenuClick = (menu: string) => {\n    setActiveMenu((prev) => (prev === menu ? null : menu));\n  };\n\n  const handleItemClick = (action: () => void) => {\n    action();\n    setActiveMenu(null);\n  };\n\n  return (\n    <div\n      ref={menuBarRef}\n      className=\"mc-stone-bg w-full px-3 py-1.5 flex flex-col border-b-2 border-[#111] z-40 select-none no-print\"\n    >\n      {/* Top Row: Home Icon, Document Icon, Editable Title, Star, Cloud Sync, AI Wizard, Share, Mode */}\n      <div className=\"flex items-center justify-between gap-2 flex-wrap\">\n        <div className=\"flex items-center gap-2\">\n          {/* Home / Hub Button */}\n          {onGoHome && (\n            <button\n              onClick={onGoHome}\n              className=\"bg-[#2a2a2a] hover:bg-[#383838] border-2 border-[#555] hover:border-[#FFD700] p-1.5 text-white flex items-center gap-1.5 shadow-sm transition-colors cursor-pointer\"\n              title=\"Return to Minecraft Documents Hub (Home Page)\"\n            >\n              <Home className=\"w-4 h-4 text-yellow-400\" />\n              <span className=\"font-pixel text-[9px] hidden sm:inline text-gray-200\">HOME</span>\n            </button>\n          )}\n\n          {/* Logo & Inventory Toggle Icon */}\n          <button\n            onClick={onToggleSidebar}\n            className=\"mc-slot w-8 h-8 flex items-center justify-center text-sm shrink-0 cursor-pointer\"\n            title={isSidebarOpen ? \'Close Inventory Sidebar\' : \'Open Inventory Sidebar\'}\n          >\n            <span>{activePage?.icon || \'\360\237\223\234\'}</span>\n          </button>\n\n          {/* Document Title & Status */}\n          <div className=\"flex flex-col\">\n            <div className=\"flex items-center gap-1.5\">\n              <input\n                type=\"text\"\n                value={activePage?.title || \'\'}\n                onChange={(e) => onUpdateTitle(e.target.value)}\n                placeholder=\"Untitled document\"\n                className=\"bg-transparent text-white font-pixel text-xs sm:text-sm font-bold hover:bg-black/30 px-1.5 py-0.5 border border-transparent hover:border-[#555] focus:border-[#FFD700] focus:bg-black/50 focus:outline-hidden max-w-[140px] sm:max-w-xs md:max-w-md truncate\"\n              />\n\n              {/* Star Button */}\n              <button\n                onClick={onToggleStar}\n                className=\"text-sm text-yellow-400 hover:scale-110 transition-transform cursor-pointer p-0.5\"\n                title={activePage?.isStarred ? \'Unstar document\' : \'Star document\'}\n              >\n                {activePage?.isStarred ? \'\342\255\220\' : \'\342\230\206\'}\n              </button>\n\n              {/* Google Drive Status Link */}\n              {onOpenGoogleDriveModal && (\n                <button\n                  onClick={onOpenGoogleDriveModal}\n                  className=\"flex items-center gap-1 text-[9px] font-pixel bg-[#1e2a38] hover:bg-[#283b50] border border-[#4285F4] px-1.5 py-0.5 text-blue-300 transition-colors\"\n                  title=\"Google Drive Cloud Sync\"\n                >\n                  <Cloud className=\"w-3 h-3 text-[#4285F4]\" />\n                  <span className=\"hidden md:inline\">\n                    {activePage?.driveSyncedAt ? \'Drive Synced\' : \'Sync Drive\'}\n                  </span>\n                </button>\n              )}\n            </div>\n          </div>\n        </div>\n\n        {/* Right Action Controls: Gemini AI Enchantment, Share Button, Mode Switcher, Settings */}\n        <div className=\"flex items-center gap-2 ml-auto\">\n          {/* Gemini AI Spellcheck & Scribe Assistant */}\n          {onOpenGeminiModal && (\n            <button\n              onClick={onOpenGeminiModal}\n              className=\"mc-enchanted-btn px-2.5 py-1 text-xs font-pixel flex items-center gap-1.5 cursor-pointer shadow-md\"\n              title=\"Gemini AI Spellcheck, Proofreading & Ancient Scribe\"\n            >\n              <Sparkles className=\"w-3.5 h-3.5 text-yellow-300 animate-pulse\" />\n              <span className=\"text-[10px] hidden sm:inline\">AI ENCHANT</span>\n            </button>\n          )}\n\n          {/* Share Realm Button (Google Docs Style) */}\n          {onOpenShareModal && (\n            <button\n              onClick={onOpenShareModal}\n              className=\"mc-button-green px-3 py-1 text-xs font-pixel text-white flex items-center gap-1.5 cursor-pointer shadow-md\"\n              title=\"Share Realm Document with Co-crafters\"\n            >\n              <Share2 className=\"w-3.5 h-3.5\" />\n              <span className=\"text-[10px]\">SHARE</span>\n            </button>\n          )}\n\n          {/* Mode Switcher Pill */}\n          <button\n            onClick={onToggleMode}\n            className={`mc-button px-2.5 py-1 text-xs font-pixel flex items-center gap-1.5 cursor-pointer ${\n              mode === \'creative\'\n                ? \'bg-amber-900 border-amber-500 text-amber-200\'\n                : \'bg-stone-800 border-stone-500 text-green-300\'\n            }`}\n            title=\"Switch between Survival (Google Docs) and Creative (Notion Blocks) modes\"\n          >\n            <span>{mode === \'creative\' ? \'\360\237\247\261 CREATIVE\' : \'\342\232\224\357\270\217 SURVIVAL\'}</span>\n          </button>\n\n          {/* Quick Page Setup Button */}\n          <button\n            onClick={onOpenPageSetup}\n            className=\"mc-button px-2 py-1 text-xs font-pixel text-yellow-300 hidden md:flex items-center gap-1 cursor-pointer\"\n            title=\"Configure Page Size (A4 Default, Letter, Legal, Book, Pageless) and Margins\"\n          >\n            <span>\360\237\223\204</span>\n            <span className=\"uppercase text-[9px]\">\n              {pageSettings.pageSize.toUpperCase()}\n            </span>\n          </button>\n\n          {/* Settings Button */}\n          <button\n            onClick={onOpenSettings}\n            className=\"mc-button p-1.5 text-xs font-pixel text-gray-300 hover:text-white flex items-center cursor-pointer\"\n            title=\"Document & Profile Settings\"\n          >\n            <Settings className=\"w-3.5 h-3.5\" />\n          </button>\n        </div>\n      </div>"
    }
