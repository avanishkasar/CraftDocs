      target_content: "/* Parchment Book Page Texture */\n.mc-parchment-bg {\n  background-color: #fdf6e3;\n  border: 6px solid #8B6914;\n  box-shadow: inset 0 0 40px rgba(0,0,0,0.05), 4px 4px 0 #000;\n  color: #2c2211;\n}\n\n/* Nether Obsidian Night Parchment */\n.mc-night-parchment {\n  background-color: #121224;\n  background-image: radial-gradient(#252545 1px, transparent 0);\n  background-size: 8px 8px;\n  border: 6px solid #c042da;\n  box-shadow: inset 0 0 50px rgba(192, 66, 218, 0.15), 4px 4px 0 #000;\n  color: #f0e6ff;\n}\n\n.mc-night-parchment input,\n.mc-night-parchment div[contenteditable] {\n  color: #f0e6ff !important;\n}"
      replacement_content: "/* Parchment Book Page Texture */\n.mc-parchment-bg {\n  background-color: #fdf6e3;\n  border: 6px solid #8B6914;\n  box-shadow: inset 0 0 40px rgba(0,0,0,0.05), 4px 4px 0 #000;\n  color: #2c2211;\n}\n\n/* Default Clean White Google Docs Paper with Minecraft Accent */\n.mc-page-white {\n  background-color: #ffffff;\n  color: #1a1a1a;\n  border: 1px solid #d1d5db;\n  box-shadow: 0 1px 3px 0 rgba(60,64,67,.3), 0 4px 8px 3px rgba(60,64,67,.15);\n}\n\n.mc-page-white input,\n.mc-page-white div[contenteditable] {\n  color: #1a1a1a !important;\n}\n\n/* Warm Ivory Paper */\n.mc-page-ivory {\n  background-color: #faf8f5;\n  color: #1f2937;\n  border: 1px solid #e5e7eb;\n  box-shadow: 0 1px 3px 0 rgba(60,64,67,.25), 0 4px 8px 3px rgba(60,64,67,.1);\n}\n\n.mc-page-ivory input,\n.mc-page-ivory div[contenteditable] {\n  color: #1f2937 !important;\n}\n\n/* Classic Parchment Paper */\n.mc-page-parchment {\n  background-color: #fdf6e3;\n  color: #2c2211;\n  border: 4px solid #8B6914;\n  box-shadow: inset 0 0 30px rgba(0,0,0,0.04), 4px 4px 0 #000;\n}\n\n.mc-page-parchment input,\n.mc-page-parchment div[contenteditable] {\n  color: #2c2211 !important;\n}\n\n/* Nether Obsidian Night Parchment */\n.mc-page-obsidian,\n.mc-night-parchment {\n  background-color: #121224;\n  background-image: radial-gradient(#252545 1px, transparent 0);\n  background-size: 8px 8px;\n  border: 4px solid #c042da;\n  box-shadow: inset 0 0 50px rgba(192, 66, 218, 0.15), 4px 4px 0 #000;\n  color: #f0e6ff;\n}\n\n.mc-page-obsidian input,\n.mc-page-obsidian div[contenteditable],\n.mc-night-parchment input,\n.mc-night-parchment div[contenteditable] {\n  color: #f0e6ff !important;\n}\n\n/* Ender Void Theme */\n.mc-page-void {\n  background-color: #0b1120;\n  color: #e2e8f0;\n  border: 4px solid #0284c7;\n  box-shadow: inset 0 0 40px rgba(2, 132, 199, 0.2), 4px 4px 0 #000;\n}\n\n.mc-page-void input,\n.mc-page-void div[contenteditable] {\n  color: #e2e8f0 !important;\n}\n\n/* Print Stylesheet for Google Docs PDF Output */\n@media print {\n  body {\n    background-color: #ffffff !important;\n    color: #000000 !important;\n    overflow: visible !important;\n  }\n  header, footer, nav, aside, .no-print, [title*=\"Creeper\"], .mc-slot, .mc-button, .mc-xp-track {\n    display: none !important;\n  }\n  main, .flex-1 {\n    display: block !important;\n    overflow: visible !important;\n    background: transparent !important;\n    padding: 0 !important;\n    margin: 0 !important;\n  }\n  .mc-page-white, .mc-page-parchment, .mc-page-ivory, .mc-page-obsidian, .mc-page-void {\n    box-shadow: none !important;\n    border: none !important;\n    width: 100% !important;\n    max-width: 100% !important;\n    padding: 0 !important;\n    margin: 0 !important;\n    background: #ffffff !important;\n    color: #000000 !important;\n  }\n  .mc-page-white input, div[contenteditable] {\n    color: #000000 !important;\n  }\n}"
    }
    diff {
      end_line: 246
      unified_diff {
        lines {
          text: "/* Minecraft Pixel Theme Styles - Geometric Balance Theme */"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
