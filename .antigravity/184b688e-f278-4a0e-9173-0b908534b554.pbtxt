  file_change {
    absolute_path_uri: "file:///src/components/Toolbar.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { EditorMode, PageSettings } from \'../types/editor\';\n\ninterface ToolbarProps {\n  mode: EditorMode;\n  onToggleMode: () => void;\n  onFormat: (command: string, value?: string) => void;\n  activeFormats?: Record<string, boolean>;\n  pageSettings?: PageSettings;\n  onOpenPageSetup?: () => void;\n  onOpenFindReplace?: () => void;\n  onOpenSpecialCharacters?: () => void;\n  onSidebarToggle?: () => void;\n  isSidebarOpen?: boolean;\n}\n\nconst MINECRAFT_COLORS = [\n  { name: \'Default Black\', color: \'#1a1a1a\', icon: \'\342\254\233\' },\n  { name: \'Redstone Red\', color: \'#dc2626\', icon: \'\360\237\224\264\' },\n  { name: \'Gold Yellow\', color: \'#d97706\', icon: \'\360\237\237\241\' },\n  { name: \'Emerald Green\', color: \'#16a34a\', icon: \'\360\237\237\242\' },\n  { name: \'Diamond Cyan\', color: \'#0284c7\', icon: \'\360\237\224\267\' },\n  { name: \'Lapis Blue\', color: \'#2563eb\', icon: \'\360\237\224\265\' },\n  { name: \'Nether Purple\', color: \'#9333ea\', icon: \'\360\237\237\243\' },\n  { name: \'Charcoal Gray\', color: \'#4b5563\', icon: \'\342\227\275\' },\n];\n\nconst HIGHLIGHT_COLORS = [\n  { name: \'Yellow Glow\', color: \'#fef08a\', icon: \'\360\237\237\241\' },\n  { name: \'Emerald Aura\', color: \'#bbf7d0\', icon: \'\360\237\237\242\' },\n  { name: \'Diamond Shimmer\', color: \'#bae6fd\', icon: \'\360\237\224\267\' },\n  { name: \'Pink Flare\', color: \'#fbcfe8\', icon: \'\360\237\214\270\' },\n  { name: \'Orange Dusk\', color: \'#fed7aa\', icon: \'\360\237\237\240\' },\n  { name: \'None (Clear)\', color: \'transparent\', icon: \'\360\237\232\253\' },\n];\n\nexport const Toolbar: React.FC<ToolbarProps> = ({\n  mode,\n  onToggleMode,\n  onFormat,\n  activeFormats = {},\n  pageSettings,\n  onOpenPageSetup,\n  onOpenFindReplace,\n  onOpenSpecialCharacters,\n  onSidebarToggle,\n  isSidebarOpen = true,\n}) => {\n  const [showColorPicker, setShowColorPicker] = useState(false);\n  const [showHighlightPicker, setShowHighlightPicker] = useState(false);\n  const [showLineSpacing, setShowLineSpacing] = useState(false);\n  const [showTablePicker, setShowTablePicker] = useState(false);\n  const [fontSize, setFontSize] = useState(pageSettings?.fontSize || 11);\n  const [fontFamily, setFontFamily] = useState(\'Arial, sans-serif\');\n\n  const handleFontSizeChange = (delta: number) => {\n    const nextSize = Math.max(8, Math.min(72, fontSize + delta));\n    setFontSize(nextSize);\n    onFormat(\'fontSize\', nextSize.toString());\n  };\n\n  const handleFontFamilySelect = (family: string) => {\n    setFontFamily(family);\n    onFormat(\'fontName\', family);\n  };\n\n  return (\n    <header className=\"mc-stone-bg w-full min-h-[48px] px-2.5 py-1 flex items-center justify-between shadow-md relative z-30 select-none font-sans text-xs gap-1.5 border-b-2 border-[#1a1a1a] flex-wrap no-print\">\n      {/* Main Google Docs Action Controls Strip */}\n      <div className=\"flex items-center gap-1 flex-wrap\">\n        {/* Undo & Redo */}\n        <div className=\"flex items-center gap-0.5\">\n          <button\n            onClick={() => onFormat(\'undo\')}\n            className=\"mc-button w-8 h-8 flex items-center justify-center text-sm rounded-xs\"\n            title=\"Undo (Ctrl+Z)\"\n          >\n            \342\206\251\357\270\217\n          </button>\n          <button\n            onClick={() => onFormat(\'redo\')}\n            className=\"mc-button w-8 h-8 flex items-center justify-center text-sm rounded-xs\"\n            title=\"Redo (Ctrl+Y)\"\n          >\n            \342\206\252\357\270\217\n          </button>\n          <button\n            onClick={() => window.print()}\n            className=\"mc-button w-8 h-8 flex items-center justify-center text-sm rounded-xs\"\n            title=\"Print (Ctrl+P)\"\n          >\n            \360\237\226\250\357\270\217\n          </button>\n        </div>\n\n        <div className=\"h-6 w-px bg-[#555] mx-1 shrink-0\" />\n\n        {/* Zoom Selector */}\n        <select\n          value={pageSettings?.zoomLevel || 100}\n          onChange={(e) => onFormat(\'zoom\', e.target.value)}\n          className=\"bg-[#2d2d2d] border border-[#555] text-gray-200 text-xs px-1.5 py-1 rounded-xs focus:outline-none focus:border-[#FFD700] h-8\"\n          title=\"Zoom Level\"\n        >\n          <option value=\"75\">75%</option>\n          <option value=\"90\">90%</option>\n          <option value=\"100\">100%</option>\n          <option value=\"125\">125%</option>\n          <option value=\"150\">150%</option>\n        </select>\n\n        <div className=\"h-6 w-px bg-[#555] mx-1 shrink-0\" />\n\n        {/* Paragraph Styles (Heading Dropdown) */}\n        <select\n          onChange={(e) => onFormat(\'formatBlock\', e.target.value)}\n          className=\"bg-[#2d2d2d] border border-[#555] text-gray-200 text-xs px-2 py-1 rounded-xs focus:outline-none focus:border-[#FFD700] h-8 max-w-[120px]\"\n          title=\"Paragraph Style\"\n          defaultValue=\"<p>\"\n        >\n          <option value=\"<p>\">Normal text</option>\n          <option value=\"<h1>\">Heading 1</option>\n          <option value=\"<h2>\">Heading 2</option>\n          <option value=\"<h3>\">Heading 3</option>\n          <option value=\"<blockquote>\">Quote Callout</option>\n          <option value=\"<pre>\">Redstone Code</option>\n        </select>\n\n        {/* Font Family Picker */}\n        <select\n          value={fontFamily}\n          onChange={(e) => handleFontFamilySelect(e.target.value)}\n          className=\"bg-[#2d2d2d] border border-[#555] text-gray-200 text-xs px-2 py-1 rounded-xs focus:outline-none focus:border-[#FFD700] h-8 max-w-[130px]\"\n          title=\"Font Family\"\n        >\n          <option value=\"Arial, sans-serif\">Arial</option>\n          <option value=\"Georgia, serif\">Georgia</option>\n          <option value=\"\'Courier Prime\', monospace\">Courier Prime</option>\n          <option value=\"\'Press Start 2P\', monospace\">Minecraft Pixel</option>\n          <option value=\"\'VT323\', monospace\">VT323 Retro</option>\n          <option value=\"\'Times New Roman\', serif\">Times New Roman</option>\n        </select>\n\n        {/* Font Size Stepper */}\n        <div className=\"flex items-center bg-[#2d2d2d] border border-[#555] rounded-xs h-8 px-1\">\n          <button\n            onClick={() => handleFontSizeChange(-1)}\n            className=\"w-5 h-6 flex items-center justify-center text-gray-300 hover:text-white font-bold\"\n            title=\"Decrease font size\"\n          >\n            -\n          </button>\n          <span className=\"w-6 text-center text-xs text-amber-200 font-pixel\">\n            {fontSize}\n          </span>\n          <button\n            onClick={() => handleFontSizeChange(1)}\n            className=\"w-5 h-6 flex items-center justify-center text-gray-300 hover:text-white font-bold\"\n            title=\"Increase font size\"\n          >\n            +\n          </button>\n        </div>\n\n        <div className=\"h-6 w-px bg-[#555] mx-1 shrink-0\" />\n\n        {/* Basic Text Formatting: Bold, Italic, Underline, Strikethrough */}\n        <div className=\"flex items-center gap-0.5\">\n          <button\n            onClick={() => onFormat(\'bold\')}\n            className={`mc-button w-8 h-8 flex items-center justify-center font-bold text-sm ${\n              activeFormats.bold ? \'border-yellow-400 bg-[#444]\' : \'\'\n            }`}\n            title=\"Bold (Ctrl+B)\"\n          >\n            B\n          </button>\n          <button\n            onClick={() => onFormat(\'italic\')}\n            className={`mc-button w-8 h-8 flex items-center justify-center italic text-sm ${\n              activeFormats.italic ? \'border-yellow-400 bg-[#444]\' : \'\'\n            }`}\n            title=\"Italic (Ctrl+I)\"\n          >\n            I\n          </button>\n          <button\n            onClick={() => onFormat(\'underline\')}\n            className={`mc-button w-8 h-8 flex items-center justify-center underline text-sm ${\n              activeFormats.underline ? \'border-yellow-400 bg-[#444]\' : \'\'\n            }`}\n            title=\"Underline (Ctrl+U)\"\n          >\n            U\n          </button>\n          <button\n            onClick={() => onFormat(\'strikeThrough\')}\n            className={`mc-button w-8 h-8 flex items-center justify-center line-through text-sm ${\n              activeFormats.strikethrough ? \'border-yellow-400 bg-[#444]\' : \'\'\n            }`}\n            title=\"Strikethrough\"\n          >\n            S\n          </button>\n        </div>\n\n        {/* Text Color & Highlight Color Popups */}\n        <div className=\"flex items-center gap-0.5 relative\">\n          {/* Text Color */}\n          <div className=\"relative\">\n            <button\n              onClick={() => {\n                setShowColorPicker(!showColorPicker);\n                setShowHighlightPicker(false);\n                setShowLineSpacing(false);\n              }}\n              className=\"mc-button w-8 h-8 flex flex-col items-center justify-center text-xs\"\n              title=\"Text Dye Color\"\n            >\n              <span className=\"font-bold\">A</span>\n              <div className=\"w-4 h-1 bg-red-500 rounded-full mt-0.5\" />\n            </button>\n\n            {showColorPicker && (\n              <div className=\"absolute top-10 left-0 bg-[#222] border-2 border-[#FFD700] p-2 rounded shadow-2xl z-50 grid grid-cols-4 gap-1.5 w-44\">\n                {MINECRAFT_COLORS.map((c) => (\n                  <button\n                    key={c.name}\n                    onClick={() => {\n                      onFormat(\'foreColor\', c.color);\n                      setShowColorPicker(false);\n                    }}\n                    className=\"p-1 hover:scale-110 flex items-center justify-center rounded border border-[#555] hover:border-white bg-[#333]\"\n                    title={c.name}\n                  >\n                    <div\n                      className=\"w-4 h-4 rounded-full border border-black\"\n                      style={{ backgroundColor: c.color }}\n                    />\n                  </button>\n                ))}\n              </div>\n            )}\n          </div>\n\n          {/* Highlight Color */}\n          <div className=\"relative\">\n            <button\n              onClick={() => {\n                setShowHighlightPicker(!showHighlightPicker);\n                setShowColorPicker(false);\n                setShowLineSpacing(false);\n              }}\n              className=\"mc-button w-8 h-8 flex items-center justify-center text-xs\"\n              title=\"Highlight Glow Color\"\n            >\n              <span>\360\237\226\212\357\270\217</span>\n            </button>\n\n            {showHighlightPicker && (\n              <div className=\"absolute top-10 left-0 bg-[#222] border-2 border-[#FFD700] p-2 rounded shadow-2xl z-50 flex flex-col gap-1 w-44\">\n                {HIGHLIGHT_COLORS.map((c) => (\n                  <button\n                    key={c.name}\n                    onClick={() => {\n                      onFormat(\'hiliteColor\', c.color);\n                      setShowHighlightPicker(false);\n                    }}\n                    className=\"p-1.5 hover:bg-[#444] text-left flex items-center gap-2 rounded text-xs text-white\"\n                  >\n                    <span>{c.icon}</span>\n                    <span className=\"text-[11px]\">{c.name}</span>\n                  </button>\n                ))}\n              </div>\n            )}\n          </div>\n        </div>\n\n        <div className=\"h-6 w-px bg-[#555] mx-1 shrink-0\" />\n\n        {/* Alignment */}\n        <div className=\"flex items-center gap-0.5\">\n          <button\n            onClick={() => onFormat(\'justifyLeft\')}\n            className=\"mc-button w-8 h-8 flex items-center justify-center text-xs\"\n            title=\"Align Left\"\n          >\n            \360\237\221\210\n          </button>\n          <button\n            onClick={() => onFormat(\'justifyCenter\')}\n            className=\"mc-button w-8 h-8 flex items-center justify-center text-xs\"\n            title=\"Align Center\"\n          >\n            \342\206\224\357\270\217\n          </button>\n          <button\n            onClick={() => onFormat(\'justifyRight\')}\n            className=\"mc-button w-8 h-8 flex items-center justify-center text-xs\"\n            title=\"Align Right\"\n          >\n            \360\237\221\211\n          </button>\n          <button\n            onClick={() => onFormat(\'justifyFull\')}\n            className=\"mc-button w-8 h-8 flex items-center justify-center text-xs\"\n            title=\"Justify\"\n          >\n            \360\237\223\204\n          </button>\n        </div>\n\n        {/* Line Spacing Dropdown */}\n        <div className=\"relative\">\n          <button\n            onClick={() => setShowLineSpacing(!showLineSpacing)}\n            className=\"mc-button w-8 h-8 flex items-center justify-center text-xs\"\n            title=\"Line Spacing\"\n          >\n            \342\206\225\357\270\217\n          </button>\n\n          {showLineSpacing && (\n            <div className=\"absolute top-10 left-0 bg-[#2d2d2d] border-2 border-[#FFD700] shadow-2xl py-1 z-50 text-gray-100 font-sans text-xs flex flex-col w-36\">\n              {[\n                { label: \'Single (1.0)\', val: \'1\' },\n                { label: \'1.15 (Default)\', val: \'1.15\' },\n                { label: \'1.5\', val: \'1.5\' },\n                { label: \'Double (2.0)\', val: \'2\' },\n              ].map((sp) => (\n                <button\n                  key={sp.val}\n                  onClick={() => {\n                    onFormat(\'lineSpacing\', sp.val);\n                    setShowLineSpacing(false);\n                  }}\n                  className=\"px-3 py-1.5 text-left hover:bg-[#444]\"\n                >\n                  {sp.label}\n                </button>\n              ))}\n            </div>\n          )}\n        </div>\n\n        <div className=\"h-6 w-px bg-[#555] mx-1 shrink-0\" />\n\n        {/* Lists & Indents */}\n        <div className=\"flex items-center gap-0.5\">\n          <button\n            onClick={() => onFormat(\'insertUnorderedList\')}\n            className=\"mc-button w-8 h-8 flex items-center justify-center text-xs\"\n            title=\"Bulleted List\"\n          >\n            \360\237\223\213\n          </button>\n          <button\n            onClick={() => onFormat(\'insertOrderedList\')}\n            className=\"mc-button w-8 h-8 flex items-center justify-center text-xs\"\n            title=\"Numbered List\"\n          >\n            \360\237\224\242\n          </button>\n          <button\n            onClick={() => onFormat(\'outdent\')}\n            className=\"mc-button w-8 h-8 flex items-center justify-center text-xs\"\n            title=\"Decrease Indent\"\n          >\n            \342\254\205\357\270\217\n          </button>\n          <button\n            onClick={() => onFormat(\'indent\')}\n            className=\"mc-button w-8 h-8 flex items-center justify-center text-xs\"\n            title=\"Increase Indent\"\n          >\n            \342\236\241\357\270\217\n          </button>\n        </div>\n\n        <div className=\"h-6 w-px bg-[#555] mx-1 shrink-0\" />\n\n        {/* Insert Link, Image, Special Character, Table, Clear formatting */}\n        <div className=\"flex items-center gap-0.5\">\n          <button\n            onClick={() => {\n              const url = prompt(\'Enter link URL:\', \'https://\');\n              if (url) onFormat(\'createLink\', url);\n            }}\n            className=\"mc-button w-8 h-8 flex items-center justify-center text-xs\"\n            title=\"Insert Link (Ctrl+K)\"\n          >\n            \360\237\222\216\n          </button>\n          <button\n            onClick={() => {\n              const url = prompt(\n                \'Enter image URL:\',\n                \'https://images.unsplash.com/photo-1627856013091-fed6e4e30025?w=800&auto=format&fit=crop&q=80\'\n              );\n              if (url) onFormat(\'insertImage\', url);\n            }}\n            className=\"mc-button w-8 h-8 flex items-center justify-center text-xs\"\n            title=\"Insert Image / Texture\"\n          >\n            \360\237\227\272\357\270\217\n          </button>\n          {onOpenSpecialCharacters && (\n            <button\n              onClick={onOpenSpecialCharacters}\n              className=\"mc-button w-8 h-8 flex items-center justify-center text-xs\"\n              title=\"Insert Minecraft Glyph or Special Symbol\"\n            >\n              \342\234\250\n            </button>\n          )}\n          <button\n            onClick={() => onFormat(\'removeFormat\')}\n            className=\"mc-button w-8 h-8 flex items-center justify-center text-xs\"\n            title=\"Clear Formatting\"\n          >\n            \360\237\247\271\n          </button>\n        </div>\n      </div>\n\n      {/* Right Quick Tool: Page Setup Modal Trigger */}\n      {onOpenPageSetup && (\n        <div className=\"flex items-center gap-2 ml-auto\">\n          <button\n            onClick={onOpenPageSetup}\n            className=\"mc-button px-2.5 py-1 text-xs font-pixel flex items-center gap-1 text-yellow-300 border-amber-400/60\"\n            title=\"Page Size & Layout Setup (A4 Default, White Paper)\"\n          >\n            <span>\360\237\223\204</span>\n            <span className=\"text-[10px] uppercase\">\n              {pageSettings?.pageSize?.toUpperCase() || \'A4\'}\n            </span>\n          </button>\n        </div>\n      )}\n    </header>\n  );\n};\n"
    }
